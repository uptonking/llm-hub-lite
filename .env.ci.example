# Wabase requires valid-looking 32-byte hex values at Compose parse time.
WABASE_SESSION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
WABASE_BOOT_KEY=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
# Auther (Authelia OIDC) secrets are placeholders for Compose parse time;
# the follower node provisions real values via configure-app-secrets.
AUTHER_SESSION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AUTHER_STORAGE_ENCRYPTION_KEY=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
AUTHER_JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AUTHER_OIDC_HMAC_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
AUTHER_BOOTSTRAP_ADMIN_PASSWORD=ci-auther-admin-password-0123456789abcdef
AUTHER_OIDC_LADOCS_CLIENT_SECRET=ci-auther-ladocs-client-secret-0123456789abcdef
AUTHER_OIDC_OUTLINE_CLIENT_SECRET=ci-auther-outline-client-secret-0123456789abcdef
# Ladocs (La Suite Docs) secrets are placeholders for Compose parse time; the
# follower node provisions real values via configure-app-secrets. The OIDC
# client secret mirrors the shared auther_ladocs_oidc_secret repository secret.
