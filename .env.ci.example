# Non-secret interpolation contract for Compose model validation in CI.
DOMAIN_NAME=example.invalid
SSL_EMAIL=ci@example.invalid
SHARED_NETWORK_NAME=shared_network
PLATFORM_EDGE_NETWORK=platform_edge
DATA_ROOT=/tmp/llm-hub-lite-ci/data
TZ=UTC
NODE_ID=leader
CLUSTER_POLICY_FILE=/tmp/llm-hub-lite-ci/policy.env
NODE_CONFIG_FILE=/tmp/llm-hub-lite-ci/node.env
PLATFORM_SECRET_BUNDLE_FILE=/tmp/llm-hub-lite-ci/shared-secrets.env
NEW_API_SITE=https://newapi.example.invalid
AICHOROUTER_SITE=https://aichorouter.example.invalid
CPAPI_SITE=https://cpapi.example.invalid
CURSORAPI_SITE=https://cursorapi.example.invalid
FLOWY_SITE=https://flowy.example.invalid
LIBRECHAT_SITE=https://chat.example.invalid
LIBRECHAT_ADMIN_SITE=https://chat-admin.example.invalid
PIGEON_SITE=https://pigeon.example.invalid
AICHOROUTER_SESSION_SECRET=ci-aichorouter-session-secret
AICHOROUTER_CRYPTO_SECRET=ci-aichorouter-crypto-secret
CPAPI_API_KEY=ci-cpapi-api-key
CPAPI_MANAGEMENT_KEY=ci-cpapi-management-key
CURSORAPI_CURSOR_API_KEY=ci-cursor-account-key
CURSORAPI_BRIDGE_API_KEY=ci-cursor-bridge-key
PIGEON_SECRET_KEY=ci-pigeon-secret-key
PIGEON_LOGIN_PASSWORD=ci-pigeon-login-password
NEW_API_SESSION_SECRET=ci-new-api-session-secret
NEW_API_CRYPTO_SECRET=ci-new-api-crypto-secret
NEW_API_SQL_DSN=postgresql://ci:ci@example.invalid/ci
LIBRECHAT_MONGO_URI=mongodb://ci:ci@example.invalid:27017/ci
LIBRECHAT_REDIS_URI=rediss://default:ci@example.invalid:6379
LIBRECHAT_JWT_SECRET=ci-librechat-jwt-secret
LIBRECHAT_JWT_REFRESH_SECRET=ci-librechat-jwt-refresh-secret
LIBRECHAT_ADMIN_PANEL_SESSION_SECRET=ci-librechat-admin-secret
LIBRECHAT_AWS_ENDPOINT_URL=https://storage.example.invalid
LIBRECHAT_AWS_ACCESS_KEY_ID=ci-access-key
LIBRECHAT_AWS_SECRET_ACCESS_KEY=ci-secret-key
LIBRECHAT_AWS_BUCKET_NAME=ci-bucket
LIBRECHAT_OPENROUTER_KEY=ci-openrouter-key-0123456789
WOODPECKER_SITE=https://ci.example.invalid
BESZEL_SITE=https://status.example.invalid
OBSERVER_SITE=https://observer.example.invalid
OBSERVER_INGEST_SITE=https://observer-ingest.example.invalid
OBSERVER_INGEST_URL=https://observer-ingest.example.invalid
WOODPECKER_GRPC_SITE=https://ci-grpc.example.invalid
OBSERVER_ROOT_USER_EMAIL=observer@example.invalid
OBSERVER_ROOT_USER_PASSWORD=ci-observer-password
OBSERVER_INGEST_USER=ci-collector
OBSERVER_INGEST_TOKEN=o2oi_00000000000000000000000000000000
# Wabase requires valid-looking 32-byte hex values at Compose parse time.
WABASE_SESSION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
WABASE_BOOT_KEY=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
RESTIC_REMOTE_ENABLED=false
LOW_MEMORY_SWAP_ENABLED=false
