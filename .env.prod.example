# Copy to .env.prod, set real values, and chmod 600 .env.prod.
DOMAIN_NAME=aichorage.de
SSL_EMAIL=admin@example.com
SHARED_NETWORK_NAME=shared_network
PLATFORM_EDGE_NETWORK=platform_edge
DATA_ROOT=/opt/apps/llm-hub-lite/shared/data/prod
TZ=Asia/Shanghai
CADDY_MEMORY_LIMIT=64m
CADDY_CPUS=0.25
CADDY_PIDS_LIMIT=128
WOODPECKER_SERVER_MEMORY_LIMIT=256m
WOODPECKER_SERVER_CPUS=0.50
WOODPECKER_SERVER_PIDS_LIMIT=256
WOODPECKER_AGENT_MEMORY_LIMIT=128m
WOODPECKER_AGENT_CPUS=0.50
WOODPECKER_AGENT_PIDS_LIMIT=128
WOODPECKER_DEPLOYER_MEMORY_LIMIT=128m
WOODPECKER_DEPLOYER_CPUS=0.50
WOODPECKER_DEPLOYER_PIDS_LIMIT=128
BESZEL_HUB_MEMORY_LIMIT=128m
BESZEL_HUB_CPUS=0.50
BESZEL_HUB_PIDS_LIMIT=128
BESZEL_SOCKET_PROXY_MEMORY_LIMIT=32m
BESZEL_SOCKET_PROXY_CPUS=0.10
BESZEL_SOCKET_PROXY_PIDS_LIMIT=64
BESZEL_AGENT_MEMORY_LIMIT=64m
BESZEL_AGENT_CPUS=0.25
BESZEL_AGENT_PIDS_LIMIT=128
# NODE_ID is the stable physical-node identifier. Role and leader IP are
# derived from config/cluster/policy.env and config/cluster/nodes/*.env.
NODE_ID=leader
CLUSTER_POLICY_FILE=/opt/platform/control/current/config/cluster/policy.env
NODE_CONFIG_FILE=/etc/llm-hub-lite/node.env
# Optional root-only bundle copied from the Leader to every node during first
# bootstrap. When omitted, Followers prompt for the shared values.
PLATFORM_SECRET_BUNDLE_FILE=/etc/llm-hub-lite/shared-secrets.env
# Optional root-only GitHub token for private-repository HTTPS fetches.
GITHUB_TOKEN_FILE=/etc/llm-hub-lite/github-token
# Retained for optional policy re-enable; newapi and cliproxyapi are disabled
# by default in config/cluster/policy.env.
NEW_API_SESSION_SECRET=replace-with-a-random-secret
NEW_API_CRYPTO_SECRET=replace-with-a-random-secret
NEW_API_SQL_DSN=postgresql://user:password@ep-example.neon.tech/newapi?sslmode=require
NEW_API_REDIS_URL=
CLIPROXY_API_KEY=replace-with-a-random-api-key
CLIPROXY_MANAGEMENT_KEY=replace-with-a-random-management-key
LIBRECHAT_MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/LibreChat?retryWrites=true&w=majority
LIBRECHAT_REDIS_URI=rediss://default:password@your-upstash-endpoint.upstash.io:6379
LIBRECHAT_JWT_SECRET=replace-with-a-random-secret
LIBRECHAT_JWT_REFRESH_SECRET=replace-with-a-random-secret
LIBRECHAT_ADMIN_PANEL_SESSION_SECRET=replace-with-a-random-secret
LIBRECHAT_ALLOW_REGISTRATION=true
LIBRECHAT_USE_REDIS=true
LIBRECHAT_USE_REDIS_STREAMS=true
LIBRECHAT_SEARCH=false
LIBRECHAT_API_MEMORY_LIMIT=512m
LIBRECHAT_API_CPUS=0.75
LIBRECHAT_API_PIDS_LIMIT=256
LIBRECHAT_API_NODE_OPTIONS=--max-old-space-size=384
LIBRECHAT_ADMIN_MEMORY_LIMIT=128m
LIBRECHAT_ADMIN_CPUS=0.25
LIBRECHAT_ADMIN_PIDS_LIMIT=128
LIBRECHAT_ADMIN_NODE_OPTIONS=--max-old-space-size=96
LIBRECHAT_CLIENT_MEMORY_LIMIT=32m
LIBRECHAT_CLIENT_CPUS=0.10
LIBRECHAT_CLIENT_PIDS_LIMIT=64
LIBRECHAT_MONGO_MAX_POOL_SIZE=5
LIBRECHAT_MONGO_MIN_POOL_SIZE=1
LIBRECHAT_MONGO_MAX_CONNECTING=1
LIBRECHAT_MONGO_MAX_IDLE_TIME_MS=60000
LIBRECHAT_MONGO_WAIT_QUEUE_TIMEOUT_MS=5000
LIBRECHAT_MONGO_AUTO_INDEX=false
LIBRECHAT_MONGO_AUTO_CREATE=false
LIBRECHAT_REDIS_KEY_PREFIX=aichorage-librechat-prod
LIBRECHAT_REDIS_MAX_LISTENERS=20
LIBRECHAT_REDIS_RETRY_MAX_DELAY=2000
LIBRECHAT_REDIS_RETRY_MAX_ATTEMPTS=0
LIBRECHAT_REDIS_CONNECT_TIMEOUT=5000
LIBRECHAT_REDIS_ENABLE_OFFLINE_QUEUE=false
LIBRECHAT_REDIS_PING_INTERVAL=0
LIBRECHAT_USE_REDIS_CLUSTER=false
LIBRECHAT_REDIS_CLUSTER_SAFE_DELETE=false
LIBRECHAT_REDIS_DELETE_CHUNK_SIZE=100
LIBRECHAT_REDIS_UPDATE_CHUNK_SIZE=100
LIBRECHAT_REDIS_SCAN_COUNT=100
LIBRECHAT_FORCED_IN_MEMORY_CACHE_NAMESPACES=CONFIG_STORE,APP_CONFIG
LIBRECHAT_MCP_REGISTRY_CACHE_TTL=30000
LIBRECHAT_STREAM_DELTA_COALESCE_MS=25
LIBRECHAT_MCP_INIT_TIMEOUT_MS=10000
LIBRECHAT_SCHEDULES_DISABLED=true
LIBRECHAT_DEPLOYMENT_PLUGIN_HOOKS=false
LIBRECHAT_CODE_SANDBOX_PREWARM=false
LIBRECHAT_FILE_UPLOAD_SSE_ENABLED=false
LIBRECHAT_FILE_UPLOAD_IP_MAX=10
LIBRECHAT_FILE_UPLOAD_IP_WINDOW=60
LIBRECHAT_FILE_UPLOAD_USER_MAX=20
LIBRECHAT_FILE_UPLOAD_USER_WINDOW=60
LIBRECHAT_CONVERSATION_IMPORT_MAX_FILE_SIZE_BYTES=16777216
LIBRECHAT_OTEL_SDK_DISABLED=true
LIBRECHAT_CONSOLE_JSON=false
LIBRECHAT_DOMAIN_CLIENT=https://chat.aichorage.de
LIBRECHAT_DOMAIN_SERVER=https://chat.aichorage.de
LIBRECHAT_ADMIN_PANEL_URL=https://chat-admin.aichorage.de
LIBRECHAT_SITE=https://chat.aichorage.de
LIBRECHAT_ADMIN_SITE=https://chat-admin.aichorage.de
LIBRECHAT_MONGO_BACKUP_ENABLED=false
LIBRECHAT_MONGO_BACKUP_NODE_ID=worker-1
LIBRECHAT_FILE_STRATEGY=s3
LIBRECHAT_AWS_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
LIBRECHAT_AWS_ACCESS_KEY_ID=replace-with-r2-access-key
LIBRECHAT_AWS_SECRET_ACCESS_KEY=replace-with-r2-secret-key
LIBRECHAT_AWS_REGION=auto
LIBRECHAT_AWS_BUCKET_NAME=replace-with-r2-bucket
LIBRECHAT_AWS_FORCE_PATH_STYLE=true
NEW_API_SITE=https://newapi.aichorage.de
CLIPROXY_SITE=https://cpa.aichorage.de
WOODPECKER_SITE=https://ci.aichorage.de
BESZEL_SITE=https://status.aichorage.de
WOODPECKER_GRPC_SITE=https://ci-grpc.aichorage.de
SESSION_COOKIE_TRUSTED_URL=https://newapi.aichorage.de
# Production requires a verified off-host Restic repository. Provision the
# repository and password file before the first bootstrap.
RESTIC_REMOTE_ENABLED=true
RESTIC_REMOTE_REPOSITORY=
RESTIC_REMOTE_PASSWORD_FILE=/etc/llm-hub-lite/restic-remote-password
# Optional root-only provider credentials for S3/B2/etc. The bootstrap can
# install a source file with RESTIC_REMOTE_ENV_SOURCE_FILE.
RESTIC_REMOTE_ENV_FILE=/etc/llm-hub-lite/restic-remote.env
PRODUCTION_REQUIRE_REMOTE_BACKUP=true
LOW_MEMORY_SWAP_ENABLED=true
LOW_MEMORY_SWAPFILE=/swapfile
LOW_MEMORY_SWAP_SIZE=1G
LOW_MEMORY_SWAP_SWAPPINESS=10
# Docker daemon settings are enforced by bootstrap-vps.sh. Keep this file
# root-owned and do not expose the Docker API over TCP.
# Image pins are maintained separately in ops/images.foundation.prod.env and
# ops/images.apps.prod.env.
