MANIFEST_VERSION=5
APP_ID=aichorouter
DISPLAY_NAME=Aichorouter
PLACEMENT=consumer
UPSTREAM_MODE=singleton
POLICY_FILE=cluster/apps/aichorouter.policy
ORIGIN_HOST_KEY=NODE_AICHOROUTER_ORIGIN_HOST
PUBLIC_ENDPOINTS=AICHOROUTER_SITE|aichorouter
LEADER_UPSTREAM_KEY=AICHOROUTER_UPSTREAM
ROUTE_GROUPS=AICHOROUTER_SITE|NODE_AICHOROUTER_ORIGIN_HOST|AICHOROUTER_UPSTREAM
RUNTIME_ENV_FILE=aichorouter.env
CONFIG_FILE=config.env
CLUSTER_SECRET_KEYS=
NODE_SECRET_KEYS=AICHOROUTER_SESSION_SECRET,AICHOROUTER_CRYPTO_SECRET
GENERATED_SECRET_KEYS=AICHOROUTER_SESSION_SECRET,AICHOROUTER_CRYPTO_SECRET
ENV_KEYS=AICHOROUTER_MEMORY_LIMIT,AICHOROUTER_CPUS,AICHOROUTER_PIDS_LIMIT,AICHOROUTER_GOMAXPROCS,AICHOROUTER_GOMEMLIMIT,AICHOROUTER_CRITICAL_RATE_LIMIT,AICHOROUTER_CRITICAL_RATE_LIMIT_DURATION,AICHOROUTER_MEMORY_CACHE_ENABLED,AICHOROUTER_ERROR_LOG_ENABLED,AICHOROUTER_BATCH_UPDATE_ENABLED,AICHOROUTER_SQL_MAX_IDLE_CONNS,AICHOROUTER_SQL_MAX_OPEN_CONNS,AICHOROUTER_SQL_MAX_LIFETIME,AICHOROUTER_RELAY_MAX_IDLE_CONNS,AICHOROUTER_RELAY_MAX_IDLE_CONNS_PER_HOST,AICHOROUTER_RELAY_IDLE_CONN_TIMEOUT,AICHOROUTER_MAX_REQUEST_BODY_MB,AICHOROUTER_STREAM_SCANNER_MAX_BUFFER_MB,AICHOROUTER_MAX_FILE_DOWNLOAD_MB,AICHOROUTER_SHUTDOWN_TIMEOUT_SECONDS
MOVE_MODE=fresh
STATE_MODE=sqlite
COMPOSE_FILE=compose.yml
COMPOSE_PROJECT=app-aichorouter
SERVICE_NAME=aichorouter
NETWORK_ALIAS=aichorouter
IMAGE_KEYS=AICHOROUTER_IMAGE HEALTH_PROBE_IMAGE
DATA_ROOT_REL=aichorouter
SQLITE_PATHS=aichorouter.db
HEALTH_URL=/api/status
HEALTH_PORT=3000
HEALTH_EXPECT='"success":true'
SMOKE_URL_KEY=AICHOROUTER_SITE
SMOKE_LOCAL=healthcheck
HEALTH_MODE=healthcheck
HEALTH_SERVICE=health-probe
ROUTE_TEMPLATE_FOLLOWER=route.follower.caddy
ROUTE_TEMPLATE_LEADER=route.leader.caddy
