{$AICHOROUTER_SITE} {
  # The SPA requests some collection APIs without the trailing slash the
  # backend's canonical route expects. Serve those paths directly so the
  # backend never emits a trailing-slash 301: Safari caches such redirects
  # by path and replays them instantly against the cached target, which can
  # permanently break the affected page for that browser.
  @api_noslash path /api/log /api/channel
  rewrite @api_noslash {http.request.uri.path}/
  import common_proxy
  reverse_proxy {$AICHOROUTER_UPSTREAM} {
    transport http {
      tls_insecure_skip_verify
    }
    fail_duration 30s
    health_uri /api/status
    health_interval 10s
    health_timeout 3s
    header_up Host {http.reverse_proxy.upstream.hostport}
    # Replace caller-supplied forwarding headers with Caddy's verified
    # Cloudflare client address (or the direct TCP peer).
    import forward_verified_client_ip
  }
  handle_errors {
    @upstream_unavailable expression `{http.error.status_code} >= 500`
    respond @upstream_unavailable "aichorouter unavailable" 503
  }
}
