# Single-node minimal CPU/RAM profile for Apache Answer on a shared follower VPS.
CLUB_MEMORY_LIMIT=384m
CLUB_CPUS=0.5
CLUB_PIDS_LIMIT=256
CLUB_SITE_NAME=Club
CLUB_ADMIN_USER=clubadmin
CLUB_ADMIN_EMAIL=admin@aichorage.de
# Club runs without an SMTP relay, so Answer's activation mail can never be
# delivered; leaving verification on locks every new account out permanently.
CLUB_REQUIRE_EMAIL_VERIFICATION=false
# Club is a personal site: accounts are created from the admin panel, so the
# public sign-up form stays closed. Existing accounts still log in normally.
CLUB_ALLOW_NEW_REGISTRATIONS=false
# Answer's default privilege set asks 750 reputation to create a tag, but the
# shipped posting rules require at least one tag per question, which leaves a
# fresh member unable to do either. Lower only the tag threshold.
CLUB_TAG_ADD_MIN_RANK=1
# With required_tag=false the selector still preloads the recommended tags below
# as soon as the field is focused, but any tag may be used. Set it to true to
# force every question to carry at least one of the built-in tags.
CLUB_REQUIRED_TAG=false
# Starter tag set, seeded on boot: slug|display name|description
CLUB_BUILTIN_TAGS=support|Support|For general support questions.;question|Question|Questions about how club itself works.;bug|Bug|Something is broken or behaves unexpectedly.;feature-request|Feature request|Ideas for new capabilities.;how-to|How To|Step by step instructions and walkthroughs.;discussion|Discussion|Open ended conversation and opinions.;announcement|Announcement|News and updates about this site.
