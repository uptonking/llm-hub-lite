MANIFEST_VERSION=5
APP_ID=club
DISPLAY_NAME=Club (Apache Answer)
PLACEMENT=consumer
UPSTREAM_MODE=singleton
POLICY_FILE=cluster/apps/club.policy
ORIGIN_HOST_KEY=NODE_CLUB_ORIGIN_HOST
PUBLIC_ENDPOINTS=CLUB_SITE|club
LEADER_UPSTREAM_KEY=CLUB_UPSTREAM
ROUTE_GROUPS=CLUB_SITE|NODE_CLUB_ORIGIN_HOST|CLUB_UPSTREAM
RUNTIME_ENV_FILE=club.env
RUNTIME_ENV_PROVISION=stage
CONFIG_FILE=config.env
CLUSTER_SECRET_KEYS=
NODE_SECRET_KEYS=CLUB_ADMIN_PASSWORD
GENERATED_SECRET_KEYS=CLUB_ADMIN_PASSWORD
GENERATED_SECRET_BYTES=CLUB_ADMIN_PASSWORD:16
SECRET_MIN_LENGTHS=CLUB_ADMIN_PASSWORD:32
SECRET_REGEXES=CLUB_ADMIN_PASSWORD:^[A-Fa-f0-9]{32}$
ENV_KEYS=CLUB_MEMORY_LIMIT,CLUB_CPUS,CLUB_PIDS_LIMIT,CLUB_SITE_NAME,CLUB_ADMIN_USER,CLUB_ADMIN_EMAIL,CLUB_REQUIRE_EMAIL_VERIFICATION
MOVE_MODE=fresh
STATE_MODE=sqlite
DATA_ROOT_REL=club
SQLITE_PATHS=sqlite3/answer.db
RECOVERY_REQUIRED_PATHS=sqlite3/answer.db
COMPOSE_FILE=compose.yml
COMPOSE_PROJECT=app-club
SERVICE_NAME=club
NETWORK_ALIAS=club
IMAGE_KEYS=CLUB_IMAGE
HEALTH_URL=/answer/api/v1/siteinfo
HEALTH_PORT=80
HEALTH_EXPECT="version"
SMOKE_URL_KEY=CLUB_SITE
SMOKE_LOCAL=healthcheck
HEALTH_MODE=healthcheck
HEALTH_SERVICE=
ROUTE_TEMPLATE_FOLLOWER=route.follower.caddy
ROUTE_TEMPLATE_LEADER=route.leader.caddy
