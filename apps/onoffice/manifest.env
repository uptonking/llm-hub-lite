MANIFEST_VERSION=5
APP_ID=onoffice
DISPLAY_NAME=OnlyOffice
PLACEMENT=consumer
UPSTREAM_MODE=singleton
POLICY_FILE=cluster/apps/onoffice.policy
ORIGIN_HOST_KEY=NODE_ONOFFICE_ORIGIN_HOST
PUBLIC_ENDPOINTS=ONOFFICE_SITE|onoffice
LEADER_UPSTREAM_KEY=ONOFFICE_UPSTREAM
ROUTE_GROUPS=ONOFFICE_SITE|NODE_ONOFFICE_ORIGIN_HOST|ONOFFICE_UPSTREAM
RUNTIME_ENV_FILE=onoffice.env
RUNTIME_ENV_PROVISION=stage
CONFIG_FILE=config.env
CLUSTER_SECRET_KEYS=ONOFFICE_EXAMPLE_AUTH_USER,ONOFFICE_EXAMPLE_AUTH_HASH
NODE_SECRET_KEYS=ONOFFICE_JWT_SECRET
DEPLOYMENT_SECRET_KEYS=ONOFFICE_EXAMPLE_AUTH_USER,ONOFFICE_EXAMPLE_AUTH_HASH
WOODPECKER_SECRET_NAMES=ONOFFICE_JWT_SECRET:onoffice_jwt_secret,ONOFFICE_EXAMPLE_AUTH_USER:onoffice_example_auth_user,ONOFFICE_EXAMPLE_AUTH_HASH:onoffice_example_auth_hash
SECRET_MIN_LENGTHS=ONOFFICE_JWT_SECRET:32,ONOFFICE_EXAMPLE_AUTH_USER:1,ONOFFICE_EXAMPLE_AUTH_HASH:60
SECRET_REGEXES=ONOFFICE_EXAMPLE_AUTH_USER:^[A-Za-z0-9._-]+$,ONOFFICE_EXAMPLE_AUTH_HASH:^\$2[aby]\$[0-9]{2}\$[./A-Za-z0-9]{53}$
ENV_KEYS=ONOFFICE_MEMORY_LIMIT,ONOFFICE_CPUS,ONOFFICE_PIDS_LIMIT
MOVE_MODE=fresh
STATE_MODE=files
DATA_ROOT_REL=onoffice
COMPOSE_FILE=compose.yml
COMPOSE_PROJECT=app-onoffice
SERVICE_NAME=onoffice
NETWORK_ALIAS=onoffice
IMAGE_KEYS=ONOFFICE_IMAGE
HEALTH_URL=/healthcheck
HEALTH_PORT=80
HEALTH_EXPECT=true
SMOKE_URL_KEY=ONOFFICE_SITE
SMOKE_LOCAL=healthcheck
HEALTH_MODE=healthcheck
HEALTH_SERVICE=
ROUTE_TEMPLATE_FOLLOWER=route.follower.caddy
ROUTE_TEMPLATE_LEADER=route.leader.caddy
