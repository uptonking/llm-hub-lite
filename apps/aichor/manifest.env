MANIFEST_VERSION=5
APP_ID=aichor
DISPLAY_NAME=Aichor (Paseo)
PLACEMENT=consumer
UPSTREAM_MODE=singleton
POLICY_FILE=cluster/apps/aichor.policy
ORIGIN_HOST_KEY=NODE_AICHOR_ORIGIN_HOST
PUBLIC_ENDPOINTS=AICHOR_SITE|aichor
LEADER_UPSTREAM_KEY=AICHOR_UPSTREAM
ROUTE_GROUPS=AICHOR_SITE|NODE_AICHOR_ORIGIN_HOST|AICHOR_UPSTREAM
RUNTIME_ENV_FILE=aichor.env
RUNTIME_ENV_PROVISION=stage
CONFIG_FILE=config.env
CLUSTER_SECRET_KEYS=
NODE_SECRET_KEYS=AICHOR_PASSWORD
GENERATED_SECRET_KEYS=AICHOR_PASSWORD
GENERATED_SECRET_BYTES=AICHOR_PASSWORD:32
SECRET_MIN_LENGTHS=AICHOR_PASSWORD:32
ENV_KEYS=AICHOR_MEMORY_LIMIT,AICHOR_CPUS,AICHOR_PIDS_LIMIT,AICHOR_LOG_LEVEL,AICHOR_LOG_FORMAT,AICHOR_HOSTNAMES,AICHOR_TRUSTED_PROXIES,AICHOR_CORS_ORIGINS
MOVE_MODE=fresh
STATE_MODE=files
COMPOSE_FILE=compose.yml
COMPOSE_PROJECT=app-aichor
SERVICE_NAME=aichor
NETWORK_ALIAS=aichor
IMAGE_KEYS=AICHOR_IMAGE
DATA_ROOT_REL=aichor
HEALTH_URL=/api/health
HEALTH_PORT=6767
HEALTH_EXPECT='"status":"ok"'
SMOKE_URL_KEY=AICHOR_SITE
SMOKE_LOCAL=healthcheck
HEALTH_MODE=healthcheck
HEALTH_SERVICE=
ROUTE_TEMPLATE_FOLLOWER=route.follower.caddy
ROUTE_TEMPLATE_LEADER=route.leader.caddy
