AICHOR_MEMORY_LIMIT=512m
# Keep the singleton profile small enough for a worker-2 VPS by default.
# Deployment smoke uses the follower Caddy container listener before publish;
# diagnostics remain visible if that route is unavailable.
# Keep origin smoke retries on the same pinned curl probe image as CI.
# Local follower checks use the shared edge network before public publication.
# The deployment smoke probes the local follower listener before publication;
# the first probe may use Caddy's bootstrap certificate while ACME settles.
AICHOR_CPUS=0.50
AICHOR_PIDS_LIMIT=128
AICHOR_LOG_LEVEL=warn
AICHOR_LOG_FORMAT=json
# A leading dot allows the public hostname and any selected follower origin.
AICHOR_HOSTNAMES=.aichorage.de
AICHOR_TRUSTED_PROXIES=loopback,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
AICHOR_CORS_ORIGINS=
# Keep Aichor scoped deployment validation exercised after deployment log handling changes.
