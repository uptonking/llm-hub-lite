{$AICHOR_SITE} {
  import common_proxy
  reverse_proxy {$AICHOR_UPSTREAM} {
    # The follower origin is protected by the node firewall and uses Caddy's
    # internal CA because public ACME validation cannot reach DNS-only origin
    # records. Keep encryption on the hop while accepting that private cert.
    transport http {
      tls_insecure_skip_verify
    }
    fail_duration 30s
    health_uri /api/health
    health_interval 10s
    health_timeout 5s
    health_fails 3
    health_passes 1

    # Preserve headers for proper WebSocket and origin detection
    header_up Host {http.reverse_proxy.upstream.hostport}
    header_up X-Forwarded-Proto {scheme}
    header_up X-Forwarded-For {remote_host}

    # WebSocket support - critical for Paseo UI connection
    header_up Upgrade {http.request.header.Upgrade}
    header_up Connection {http.request.header.Connection}

    import forward_verified_client_ip
  }
  handle_errors {
    @upstream_unavailable expression `{http.error.status_code} >= 500`
    respond @upstream_unavailable "aichor unavailable" 503
  }
}
