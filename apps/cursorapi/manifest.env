MANIFEST_VERSION=5
APP_ID=cursorapi
DISPLAY_NAME=Cursor API Proxy
PLACEMENT=consumer
UPSTREAM_MODE=singleton
POLICY_FILE=cluster/apps/cursorapi.policy
ORIGIN_HOST_KEY=NODE_CURSORAPI_ORIGIN_HOST
PUBLIC_ENDPOINTS=CURSORAPI_SITE|cursorapi
LEADER_UPSTREAM_KEY=CURSORAPI_UPSTREAM
ROUTE_GROUPS=CURSORAPI_SITE|NODE_CURSORAPI_ORIGIN_HOST|CURSORAPI_UPSTREAM
RUNTIME_ENV_FILE=cursorapi.env
CONFIG_FILE=config.env
CLUSTER_SECRET_KEYS=
NODE_SECRET_KEYS=CURSORAPI_CURSOR_API_KEY,CURSORAPI_BRIDGE_API_KEY
GENERATED_SECRET_KEYS=CURSORAPI_BRIDGE_API_KEY
SECRET_MIN_LENGTHS=CURSORAPI_CURSOR_API_KEY:16,CURSORAPI_BRIDGE_API_KEY:32
ENV_KEYS=CURSORAPI_MEMORY_LIMIT,CURSORAPI_CPUS,CURSORAPI_PIDS_LIMIT,CURSORAPI_MODE,CURSORAPI_TIMEOUT_MS,CURSORAPI_CHAT_ONLY_WORKSPACE,CURSORAPI_USE_ACP,CURSORAPI_VERBOSE,CURSORAPI_MAX_MODE,CURSORAPI_MULTI_PORT
MOVE_MODE=fresh
STATE_MODE=ephemeral
COMPOSE_FILE=compose.yml
COMPOSE_PROJECT=app-cursorapi
SERVICE_NAME=cursorapi
NETWORK_ALIAS=cursorapi
IMAGE_KEYS=CURSORAPI_IMAGE HEALTH_PROBE_IMAGE
DATA_ROOT_REL=cursorapi
HEALTH_URL=/healthz
HEALTH_EXPECT=ok
SMOKE_URL_KEY=CURSORAPI_SITE
SMOKE_LOCAL=healthcheck
HEALTH_MODE=healthcheck
HEALTH_SERVICE=health-probe
ROUTE_TEMPLATE_FOLLOWER=route.follower.caddy
ROUTE_TEMPLATE_LEADER=route.leader.caddy
