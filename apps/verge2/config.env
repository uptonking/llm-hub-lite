VERGE2_MEMORY_LIMIT=512m
VERGE2_CPUS=0.5
VERGE2_PIDS_LIMIT=64
VERGE2_LOG_LEVEL=warn
VERGE2_GOMAXPROCS=1
VERGE2_GOMEMLIMIT=450MiB
VERGE2_DOMAIN=verge2.aichorage.de
VERGE2_ACME_EMAIL=admin@aichorage.de
# DNS-01 certificate issuance reuses the Cloudflare token from verge.
# Runtime secrets are reconciled during the follower staging transaction.
# Direct singleton publication uses a local socket smoke check.
# Firewall published-port policy is reconciled via host systemd path trigger.
