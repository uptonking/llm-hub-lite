MANIFEST_VERSION=5
APP_ID=verge2
DISPLAY_NAME=Verge2 (Hysteria)
PLACEMENT=consumer
UPSTREAM_MODE=singleton
INGRESS_MODE=direct
DIRECT_LISTENERS=udp:443:443
DIRECT_PORT_RANGES=udp:20000:30000:443
DIRECT_PROBE=socket
POLICY_FILE=cluster/apps/verge2.policy
PUBLIC_ENDPOINTS=VERGE2_SITE|verge2
RUNTIME_ENV_FILE=verge2.env
RUNTIME_ENV_PROVISION=stage
RUNTIME_CONFIG_TEMPLATE=config.yaml.tmpl
RUNTIME_CONFIG_FILE=runtime/verge2/config.yaml
CONFIG_FILE=config.env
CLUSTER_SECRET_KEYS=
NODE_SECRET_KEYS=VERGE2_AUTH_PASSWORD,VERGE2_CLOUDFLARE_API_TOKEN
WOODPECKER_SECRET_NAMES=VERGE2_CLOUDFLARE_API_TOKEN:verge_cloudflare_api_token
GENERATED_SECRET_KEYS=VERGE2_AUTH_PASSWORD
GENERATED_SECRET_BYTES=VERGE2_AUTH_PASSWORD:32
SECRET_MIN_LENGTHS=VERGE2_AUTH_PASSWORD:32,VERGE2_CLOUDFLARE_API_TOKEN:20
ENV_KEYS=VERGE2_MEMORY_LIMIT,VERGE2_CPUS,VERGE2_PIDS_LIMIT,VERGE2_LOG_LEVEL,VERGE2_GOMAXPROCS,VERGE2_GOMEMLIMIT,VERGE2_DOMAIN,VERGE2_ACME_EMAIL
MOVE_MODE=fresh
STATE_MODE=files
COMPOSE_FILE=compose.yml
COMPOSE_PROJECT=app-verge2
SERVICE_NAME=verge2
NETWORK_ALIAS=verge2
IMAGE_KEYS=VERGE2_IMAGE
DATA_ROOT_REL=verge2
HEALTH_URL=/
SMOKE_URL_KEY=VERGE2_SITE
SMOKE_LOCAL=healthcheck
HEALTH_MODE=process
HEALTH_SERVICE=
