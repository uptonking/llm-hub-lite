MANIFEST_VERSION=5
APP_ID=wapdf
DISPLAY_NAME=Wapdf (BentoPDF)
PLACEMENT=consumer
UPSTREAM_MODE=singleton
POLICY_FILE=cluster/apps/wapdf.policy
ORIGIN_HOST_KEY=NODE_WAPDF_ORIGIN_HOST
PUBLIC_ENDPOINTS=WAPDF_SITE|wapdf
LEADER_UPSTREAM_KEY=WAPDF_UPSTREAM
ROUTE_GROUPS=WAPDF_SITE|NODE_WAPDF_ORIGIN_HOST|WAPDF_UPSTREAM
RUNTIME_ENV_FILE=
CONFIG_FILE=config.env
CLUSTER_SECRET_KEYS=
NODE_SECRET_KEYS=
GENERATED_SECRET_KEYS=
ENV_KEYS=WAPDF_MEMORY_LIMIT,WAPDF_CPUS,WAPDF_PIDS_LIMIT
MOVE_MODE=fresh
STATE_MODE=ephemeral
COMPOSE_FILE=compose.yml
COMPOSE_PROJECT=app-wapdf
SERVICE_NAME=wapdf
NETWORK_ALIAS=wapdf
IMAGE_KEYS=WAPDF_IMAGE HEALTH_PROBE_IMAGE
DATA_ROOT_REL=
HEALTH_URL=/
HEALTH_EXPECT=<title>PDF Tools</title>
SMOKE_URL_KEY=WAPDF_SITE
SMOKE_LOCAL=healthcheck
HEALTH_MODE=healthcheck
HEALTH_SERVICE=health-probe
ROUTE_TEMPLATE_FOLLOWER=route.follower.caddy
ROUTE_TEMPLATE_LEADER=route.leader.caddy
