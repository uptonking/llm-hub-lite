{$NODE_SEARX_ORIGIN_HOST} {
  tls internal
  import common_proxy
  @searx_auth_required {
    not path /healthz
  }
  basic_auth @searx_auth_required {
    {$SEARX_AUTH_USER} {$SEARX_AUTH_HASH}
  }
  reverse_proxy searx:8080 {
    flush_interval -1
    header_up Host {$SEARX_SITE_HOST}
    header_up X-Forwarded-Host {$SEARX_SITE_HOST}
    header_up X-Forwarded-Proto https
    header_up X-Forwarded-For {remote_host}
    import forward_verified_client_ip
  }
}
