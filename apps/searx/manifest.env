MANIFEST_VERSION=5
APP_ID=searx
DISPLAY_NAME=SearXNG
PLACEMENT=consumer
UPSTREAM_MODE=singleton
POLICY_FILE=cluster/apps/searx.policy
ORIGIN_HOST_KEY=NODE_SEARX_ORIGIN_HOST
PUBLIC_ENDPOINTS=SEARX_SITE|searx
LEADER_UPSTREAM_KEY=SEARX_UPSTREAM
ROUTE_GROUPS=SEARX_SITE|NODE_SEARX_ORIGIN_HOST|SEARX_UPSTREAM
RUNTIME_ENV_FILE=searx.env
RUNTIME_ENV_PROVISION=stage
CONFIG_FILE=config.env
CLUSTER_SECRET_KEYS=SEARX_AUTH_USER,SEARX_AUTH_HASH
NODE_SECRET_KEYS=SEARX_SECRET
DEPLOYMENT_SECRET_KEYS=SEARX_AUTH_USER,SEARX_AUTH_HASH
GENERATED_SECRET_KEYS=SEARX_SECRET
GENERATED_SECRET_BYTES=SEARX_SECRET:32
SECRET_MIN_LENGTHS=SEARX_SECRET:32,SEARX_AUTH_USER:1,SEARX_AUTH_HASH:60
SECRET_REGEXES=SEARX_AUTH_USER:^[A-Za-z0-9._-]+$,SEARX_AUTH_HASH:^\$2[aby]\$[0-9]{2}\$[./A-Za-z0-9]{53}$
ENV_KEYS=SEARX_MEMORY_LIMIT,SEARX_CPUS,SEARX_PIDS_LIMIT,SEARX_PORT,SEARX_BIND_ADDRESS,SEARX_BASE_URL,SEARX_LIMITER,SEARX_PUBLIC_INSTANCE,SEARX_IMAGE_PROXY,SEARX_METHOD
WOODPECKER_SECRET_NAMES=SEARX_SECRET:searx_secret,SEARX_AUTH_USER:searx_auth_user,SEARX_AUTH_HASH:searx_auth_hash
MOVE_MODE=fresh
STATE_MODE=files
COMPOSE_FILE=compose.yml
COMPOSE_PROJECT=app-searx
SERVICE_NAME=searx
NETWORK_ALIAS=searx
IMAGE_KEYS=SEARX_IMAGE
DATA_ROOT_REL=searx
HEALTH_URL=/healthz
HEALTH_PORT=8080
HEALTH_EXPECT=OK
SMOKE_URL_KEY=SEARX_SITE
SMOKE_LOCAL=healthcheck
HEALTH_MODE=healthcheck
HEALTH_SERVICE=
ROUTE_TEMPLATE_FOLLOWER=route.follower.caddy
ROUTE_TEMPLATE_LEADER=route.leader.caddy
