{$SEARX_SITE} {
  import common_proxy
  @searx_auth_required {
    not path /healthz
  }
  basic_auth @searx_auth_required {
    {$SEARX_AUTH_USER} {$SEARX_AUTH_HASH}
  }
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
  }
  reverse_proxy {$SEARX_UPSTREAM} {
    transport http {
      tls_insecure_skip_verify
    }
    fail_duration 30s
    health_uri /healthz
    health_interval 10s
    health_timeout 5s
    health_fails 3
    health_passes 1
    header_up Host {http.reverse_proxy.upstream.hostport}
    header_up X-Forwarded-Host {$SEARX_SITE_HOST}
    header_up X-Forwarded-Proto {scheme}
    header_up X-Forwarded-For {remote_host}
    import forward_verified_client_ip
  }
  handle_errors {
    @upstream_unavailable expression `{http.error.status_code} >= 500`
    respond @upstream_unavailable "searx unavailable" 503
  }
}
