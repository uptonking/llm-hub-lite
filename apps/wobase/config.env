WOBASE_MEMORY_LIMIT=1500m
WOBASE_CPUS=0.9
WOBASE_PIDS_LIMIT=256
WOBASE_NODE_OPTIONS=--no-deprecation --max-old-space-size=768
WOBASE_DOC_WORKER_COUNT=1
WOBASE_SQLITE_MODE=wal
# Protected Quick Setup remains enabled until the operator finishes /boot.
# Deployment rollout: worker-4 singleton target; runner includes OpenSSL for secret generation.
WOBASE_IN_SERVICE=false
WOBASE_LOG_LEVEL=warn
WOBASE_TELEMETRY_LEVEL=off
WOBASE_ALLOW_AUTOMATIC_VERSION_CHECKING=false
WOBASE_LOG_HTTP=false
WOBASE_LOG_API_DETAILS=false
WOBASE_MAX_PARALLEL_REQUESTS_PER_DOC=2
WOBASE_MAX_UPLOAD_IMPORT_MB=32
WOBASE_MAX_UPLOAD_ATTACHMENT_MB=32
