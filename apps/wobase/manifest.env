MANIFEST_VERSION=5
APP_ID=wobase
DISPLAY_NAME=Wobase (Grist)
PLACEMENT=consumer
UPSTREAM_MODE=singleton
POLICY_FILE=cluster/apps/wobase.policy
ORIGIN_HOST_KEY=NODE_WOBASE_ORIGIN_HOST
PUBLIC_ENDPOINTS=WOBASE_SITE|wobase
LEADER_UPSTREAM_KEY=WOBASE_UPSTREAM
ROUTE_GROUPS=WOBASE_SITE|NODE_WOBASE_ORIGIN_HOST|WOBASE_UPSTREAM
RUNTIME_ENV_FILE=wobase.env
CONFIG_FILE=config.env
CLUSTER_SECRET_KEYS=
NODE_SECRET_KEYS=WOBASE_SESSION_SECRET,WOBASE_BOOT_KEY
GENERATED_SECRET_KEYS=WOBASE_SESSION_SECRET,WOBASE_BOOT_KEY
GENERATED_SECRET_BYTES=WOBASE_SESSION_SECRET:32,WOBASE_BOOT_KEY:32
SECRET_MIN_LENGTHS=WOBASE_SESSION_SECRET:64,WOBASE_BOOT_KEY:64
SECRET_REGEXES=WOBASE_SESSION_SECRET:^[A-Fa-f0-9]{64}$,WOBASE_BOOT_KEY:^[A-Fa-f0-9]{64}$
ENV_KEYS=WOBASE_MEMORY_LIMIT,WOBASE_CPUS,WOBASE_PIDS_LIMIT,WOBASE_NODE_OPTIONS,WOBASE_DOC_WORKER_COUNT,WOBASE_SQLITE_MODE,WOBASE_IN_SERVICE,WOBASE_LOG_LEVEL,WOBASE_TELEMETRY_LEVEL,WOBASE_ALLOW_AUTOMATIC_VERSION_CHECKING,WOBASE_LOG_HTTP,WOBASE_LOG_API_DETAILS,WOBASE_MAX_PARALLEL_REQUESTS_PER_DOC,WOBASE_MAX_UPLOAD_IMPORT_MB,WOBASE_MAX_UPLOAD_ATTACHMENT_MB
MOVE_MODE=fresh
STATE_MODE=sqlite
COMPOSE_FILE=compose.yml
COMPOSE_PROJECT=app-wobase
SERVICE_NAME=wobase
NETWORK_ALIAS=wobase
IMAGE_KEYS=WOBASE_IMAGE
DATA_ROOT_REL=wobase
SQLITE_PATHS=home.sqlite3
SQLITE_GLOBS=docs/*.grist
HEALTH_URL=/status?ready=1&db=1
HEALTH_EXPECT=is alive
SMOKE_URL_KEY=WOBASE_SITE
SMOKE_LOCAL=healthcheck
HEALTH_MODE=healthcheck
HEALTH_SERVICE=
ROUTE_TEMPLATE_FOLLOWER=route.follower.caddy
ROUTE_TEMPLATE_LEADER=route.leader.caddy
