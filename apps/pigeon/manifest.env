MANIFEST_VERSION=3
APP_ID=pigeon
DISPLAY_NAME=OutlookEmail / Pigeon
PLACEMENT=single-follower
UPSTREAM_MODE=singleton
POLICY_FILE=cluster/apps/pigeon.policy
TARGET_NODE_KEY=PIGEON_TARGET_NODE_ID
ORIGIN_HOST_KEY=NODE_PIGEON_ORIGIN_HOST
PUBLIC_URL_KEY=PIGEON_SITE
PUBLIC_HOST=pigeon
LEADER_UPSTREAM_KEY=PIGEON_UPSTREAM
ROUTE_GROUPS=PIGEON_SITE|NODE_PIGEON_ORIGIN_HOST|PIGEON_UPSTREAM
RUNTIME_ENV_FILE=pigeon.env
SECRET_KEYS=PIGEON_SECRET_KEY,PIGEON_LOGIN_PASSWORD
SECRET_MIN_LENGTHS=PIGEON_SECRET_KEY:32,PIGEON_LOGIN_PASSWORD:12
ENV_KEYS=PIGEON_MEMORY_LIMIT,PIGEON_CPUS,PIGEON_PIDS_LIMIT,PIGEON_GUNICORN_THREADS,PIGEON_GUNICORN_TIMEOUT,PIGEON_LOG_LEVEL,PIGEON_HTTP_REQUEST_TIMEOUT,PIGEON_IMAP_TIMEOUT,PIGEON_MAIL_FETCH_OVERALL_TIMEOUT,PIGEON_OAUTH_CLIENT_ID,PIGEON_OAUTH_REDIRECT_URI,PIGEON_GPTMAIL_BASE_URL,PIGEON_GPTMAIL_API_KEY,PIGEON_DUCKMAIL_BASE_URL,PIGEON_DUCKMAIL_API_KEY,PIGEON_CLOUDFLARE_WORKER_DOMAIN,PIGEON_CLOUDFLARE_EMAIL_DOMAINS,PIGEON_CLOUDFLARE_ADMIN_PASSWORD
MOVE_MODE=fresh
STATE_MODE=sqlite
COMPOSE_FILE=compose.yml
COMPOSE_PROJECT=app-pigeon
SERVICE_NAME=pigeon
NETWORK_ALIAS=pigeon
IMAGE_KEYS=PIGEON_IMAGE HEALTH_PROBE_IMAGE
DATA_ROOT_REL=pigeon
SQLITE_PATHS=outlook_accounts.db
HEALTH_URL=/login
HEALTH_EXPECT=
SMOKE_URL_KEY=PIGEON_SITE
SMOKE_LOCAL=healthcheck
HEALTH_MODE=healthcheck
HEALTH_SERVICE=health-probe
ROUTE_TEMPLATE_FOLLOWER=route.follower.caddy
ROUTE_TEMPLATE_LEADER=route.leader.caddy
