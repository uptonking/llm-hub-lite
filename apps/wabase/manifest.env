MANIFEST_VERSION=5
APP_ID=wabase
DISPLAY_NAME=Wabase (Grist)
PLACEMENT=consumer
UPSTREAM_MODE=singleton
POLICY_FILE=cluster/apps/wabase.policy
ORIGIN_HOST_KEY=NODE_WABASE_ORIGIN_HOST
PUBLIC_ENDPOINTS=WABASE_SITE|wabase
LEADER_UPSTREAM_KEY=WABASE_UPSTREAM
ROUTE_GROUPS=WABASE_SITE|NODE_WABASE_ORIGIN_HOST|WABASE_UPSTREAM
RUNTIME_ENV_FILE=wabase.env
CONFIG_FILE=config.env
CLUSTER_SECRET_KEYS=
NODE_SECRET_KEYS=WABASE_SESSION_SECRET,WABASE_BOOT_KEY
GENERATED_SECRET_KEYS=WABASE_SESSION_SECRET,WABASE_BOOT_KEY
GENERATED_SECRET_BYTES=WABASE_SESSION_SECRET:32,WABASE_BOOT_KEY:32
SECRET_MIN_LENGTHS=WABASE_SESSION_SECRET:64,WABASE_BOOT_KEY:64
SECRET_REGEXES=WABASE_SESSION_SECRET:^[A-Fa-f0-9]{64}$,WABASE_BOOT_KEY:^[A-Fa-f0-9]{64}$
ENV_KEYS=WABASE_MEMORY_LIMIT,WABASE_CPUS,WABASE_PIDS_LIMIT,WABASE_NODE_OPTIONS,WABASE_DOC_WORKER_COUNT,WABASE_SQLITE_MODE,WABASE_IN_SERVICE,WABASE_LOG_LEVEL,WABASE_TELEMETRY_LEVEL,WABASE_ALLOW_AUTOMATIC_VERSION_CHECKING,WABASE_LOG_HTTP,WABASE_LOG_API_DETAILS,WABASE_MAX_PARALLEL_REQUESTS_PER_DOC,WABASE_MAX_UPLOAD_IMPORT_MB,WABASE_MAX_UPLOAD_ATTACHMENT_MB
MOVE_MODE=fresh
STATE_MODE=sqlite
COMPOSE_FILE=compose.yml
COMPOSE_PROJECT=app-wabase
SERVICE_NAME=wabase
NETWORK_ALIAS=wabase
IMAGE_KEYS=WABASE_IMAGE
DATA_ROOT_REL=wabase
SQLITE_PATHS=home.sqlite3
SQLITE_GLOBS=docs/*.grist
HEALTH_URL=/status?ready=1&db=1
HEALTH_EXPECT=is alive
SMOKE_URL_KEY=WABASE_SITE
SMOKE_LOCAL=healthcheck
HEALTH_MODE=healthcheck
HEALTH_SERVICE=
ROUTE_TEMPLATE_FOLLOWER=route.follower.caddy
ROUTE_TEMPLATE_LEADER=route.leader.caddy
# Temporary, transactional identity migration contract. Remove these fields
# after the first Wabase rollout has finalized successfully on worker-4.
IDENTITY_MIGRATION_FROM_APP_ID=wobase
IDENTITY_MIGRATION_FROM_DATA_ROOT_REL=wobase
IDENTITY_MIGRATION_FROM_RUNTIME_ENV_FILE=wobase.env
IDENTITY_MIGRATION_FROM_COMPOSE_PROJECT=app-wobase
IDENTITY_MIGRATION_FROM_NETWORK=app-wobase_private
IDENTITY_MIGRATION_FROM_ENV_PREFIX=WOBASE
IDENTITY_MIGRATION_TO_ENV_PREFIX=WABASE
IDENTITY_MIGRATION_TO_NETWORK=app-wabase_private
