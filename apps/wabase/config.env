WABASE_MEMORY_LIMIT=1500m
WABASE_CPUS=0.9
WABASE_PIDS_LIMIT=256
WABASE_NODE_OPTIONS=--no-deprecation --max-old-space-size=768
WABASE_DOC_WORKER_COUNT=1
WABASE_SQLITE_MODE=wal
# Protected Quick Setup remains enabled until the operator finishes /boot.
WABASE_IN_SERVICE=false
WABASE_LOG_LEVEL=warn
WABASE_TELEMETRY_LEVEL=off
WABASE_ALLOW_AUTOMATIC_VERSION_CHECKING=false
WABASE_LOG_HTTP=false
WABASE_LOG_API_DETAILS=false
WABASE_MAX_PARALLEL_REQUESTS_PER_DOC=2
WABASE_MAX_UPLOAD_IMPORT_MB=32
WABASE_MAX_UPLOAD_ATTACHMENT_MB=32
