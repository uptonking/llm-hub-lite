AICHOR1_MEMORY_LIMIT=900m
AICHOR1_CPUS=0.80
AICHOR1_PIDS_LIMIT=384
AICHOR1_LOG_LEVEL=warn
AICHOR1_LOG_FORMAT=json
AICHOR1_HOSTNAMES=.aichorage.de
AICHOR1_TRUSTED_PROXIES=loopback,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
AICHOR1_CORS_ORIGINS=https://aichor1.aichorage.de,https://aichor.aichorage.de
AICHOR1_PI_OPENAI_ENABLED=false
AICHOR1_PI_ANTHROPIC_ENABLED=false
AICHOR1_PI_OPENROUTER_ENABLED=false
