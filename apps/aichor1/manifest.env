MANIFEST_VERSION=5
APP_ID=aichor1
DISPLAY_NAME=Aichor1 (Paseo)
PLACEMENT=consumer
UPSTREAM_MODE=singleton
POLICY_FILE=cluster/apps/aichor1.policy
ORIGIN_HOST_KEY=NODE_AICHOR1_ORIGIN_HOST
PUBLIC_ENDPOINTS=AICHOR1_SITE|aichor1
LEADER_UPSTREAM_KEY=AICHOR1_UPSTREAM
ROUTE_GROUPS=AICHOR1_SITE|NODE_AICHOR1_ORIGIN_HOST|AICHOR1_UPSTREAM
RUNTIME_ENV_FILE=aichor1.env
RUNTIME_ENV_PROVISION=stage
CONFIG_FILE=config.env
CLUSTER_SECRET_KEYS=
NODE_SECRET_KEYS=AICHOR1_PASSWORD,GH_TOKEN
OPTIONAL_SECRET_KEYS=GH_TOKEN
CONDITIONAL_SECRET_KEYS=AICHOR1_PI_OPENAI_ENABLED=true|AICHOR1_PI_OPENAI_API_KEY;AICHOR1_PI_ANTHROPIC_ENABLED=true|AICHOR1_PI_ANTHROPIC_API_KEY;AICHOR1_PI_OPENROUTER_ENABLED=true|AICHOR1_PI_OPENROUTER_API_KEY
WOODPECKER_SECRET_NAMES=AICHOR1_PASSWORD:aichor1_password,GH_TOKEN:GH_TOKEN,AICHOR1_PI_OPENAI_API_KEY:AICHOR1_PI_OPENAI_API_KEY,AICHOR1_PI_ANTHROPIC_API_KEY:AICHOR1_PI_ANTHROPIC_API_KEY,AICHOR1_PI_OPENROUTER_API_KEY:AICHOR1_PI_OPENROUTER_API_KEY
GENERATED_SECRET_KEYS=AICHOR1_PASSWORD
GENERATED_SECRET_BYTES=AICHOR1_PASSWORD:32
SECRET_MIN_LENGTHS=AICHOR1_PASSWORD:32
ENV_KEYS=AICHOR1_MEMORY_LIMIT,AICHOR1_CPUS,AICHOR1_PIDS_LIMIT,AICHOR1_LOG_LEVEL,AICHOR1_LOG_FORMAT,AICHOR1_HOSTNAMES,AICHOR1_TRUSTED_PROXIES,AICHOR1_CORS_ORIGINS,AICHOR1_PI_OPENAI_ENABLED,AICHOR1_PI_ANTHROPIC_ENABLED,AICHOR1_PI_OPENROUTER_ENABLED,AICHOR1_RELAY_ENABLED,AICHOR1_RELAY_ENDPOINT,AICHOR1_RELAY_PUBLIC_ENDPOINT,AICHOR1_RELAY_USE_TLS,AICHOR1_RELAY_PUBLIC_USE_TLS
MOVE_MODE=fresh
STATE_MODE=files
RECOVERY_REQUIRED_PATHS=.paseo/server-id,.paseo/daemon-keypair.json,.paseo/config.json
COMPOSE_FILE=compose.yml
COMPOSE_PROJECT=app-aichor1
SERVICE_NAME=aichor1
NETWORK_ALIAS=aichor1
IMAGE_KEYS=AICHOR_IMAGE
DATA_ROOT_REL=aichor1
HEALTH_URL=/api/health
HEALTH_PORT=6767
HEALTH_EXPECT='"status":"ok"'
SMOKE_URL_KEY=AICHOR1_SITE
SMOKE_LOCAL=healthcheck
HEALTH_MODE=healthcheck
HEALTH_SERVICE=
ROUTE_TEMPLATE_FOLLOWER=route.follower.caddy
ROUTE_TEMPLATE_LEADER=route.leader.caddy
