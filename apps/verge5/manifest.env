MANIFEST_VERSION=5
APP_ID=verge5
DISPLAY_NAME=Verge5 (Hysteria)
PLACEMENT=consumer
UPSTREAM_MODE=singleton
INGRESS_MODE=direct
DIRECT_LISTENERS=udp:443:443
DIRECT_PORT_RANGES=udp:20000:30000:443
DIRECT_PROBE=socket
POLICY_FILE=cluster/apps/verge5.policy
PUBLIC_ENDPOINTS=VERGE5_SITE|verge5
RUNTIME_ENV_FILE=verge5.env
RUNTIME_ENV_PROVISION=stage
RUNTIME_CONFIG_TEMPLATE=config.yaml.tmpl
RUNTIME_CONFIG_FILE=runtime/verge5/config.yaml
CONFIG_FILE=config.env
CLUSTER_SECRET_KEYS=
NODE_SECRET_KEYS=VERGE5_AUTH_PASSWORD,VERGE5_CLOUDFLARE_API_TOKEN
WOODPECKER_SECRET_NAMES=VERGE5_CLOUDFLARE_API_TOKEN:verge_cloudflare_api_token
GENERATED_SECRET_KEYS=VERGE5_AUTH_PASSWORD
GENERATED_SECRET_BYTES=VERGE5_AUTH_PASSWORD:32
SECRET_MIN_LENGTHS=VERGE5_AUTH_PASSWORD:32,VERGE5_CLOUDFLARE_API_TOKEN:20
ENV_KEYS=VERGE5_MEMORY_LIMIT,VERGE5_CPUS,VERGE5_PIDS_LIMIT,VERGE5_LOG_LEVEL,VERGE5_GOMAXPROCS,VERGE5_GOMEMLIMIT,VERGE5_DOMAIN,VERGE5_ACME_EMAIL
MOVE_MODE=fresh
STATE_MODE=files
COMPOSE_FILE=compose.yml
COMPOSE_PROJECT=app-verge5
SERVICE_NAME=verge5
NETWORK_ALIAS=verge5
IMAGE_KEYS=VERGE5_IMAGE
DATA_ROOT_REL=verge5
HEALTH_URL=/
SMOKE_URL_KEY=VERGE5_SITE
SMOKE_LOCAL=healthcheck
HEALTH_MODE=process
HEALTH_SERVICE=
