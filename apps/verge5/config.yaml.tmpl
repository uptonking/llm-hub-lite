listen: :443
acme:
  domains:
    - verge5.aichorage.de
  email: __VERGE5_ACME_EMAIL__
  type: dns
  dns:
    name: cloudflare
    config:
      cloudflare_api_token: __VERGE5_CLOUDFLARE_API_TOKEN__
auth:
  type: password
  password: __VERGE5_AUTH_PASSWORD__
masquerade:
  type: proxy
  proxy:
    url: https://www.aichorage.de/
