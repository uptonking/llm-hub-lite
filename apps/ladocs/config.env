# Resource limits sized for a 3GB budget VPS shared with the platform edge
# services. The whole project stays under ~2GB of container memory.
LADOCS_BACKEND_MEMORY_LIMIT=800m
LADOCS_BACKEND_CPUS=0.75
LADOCS_BACKEND_PIDS_LIMIT=256
LADOCS_BACKEND_WORKERS=2
LADOCS_YHUB_MEMORY_LIMIT=256m
LADOCS_YHUB_CPUS=0.50
LADOCS_YHUB_PIDS_LIMIT=192
LADOCS_YPROVIDER_MEMORY_LIMIT=256m
LADOCS_YPROVIDER_CPUS=0.50
LADOCS_YPROVIDER_PIDS_LIMIT=192
LADOCS_FRONTEND_MEMORY_LIMIT=48m
LADOCS_FRONTEND_CPUS=0.15
LADOCS_FRONTEND_PIDS_LIMIT=96
LADOCS_POSTGRES_MEMORY_LIMIT=384m
LADOCS_POSTGRES_CPUS=0.60
LADOCS_POSTGRES_SHARED_BUFFERS=64MB
LADOCS_REDIS_MEMORY_LIMIT=64m
LADOCS_REDIS_MAX_MEMORY=48mb
LADOCS_VALKEY_MEMORY_LIMIT=192m
LADOCS_VALKEY_MAX_MEMORY=128mb
LADOCS_MINIO_MEMORY_LIMIT=256m
LADOCS_MINIO_CPUS=0.40
# Object storage: a single bucket in the node-local silo instance. The bucket
# is created with versioning by the backend bootstrap script on first boot.
LADOCS_BUCKET_NAME=ladocs-media
LADOCS_MINIO_ROOT_USER=ladocs-admin
# AI assistance stays off: no external model provider is wired up.
LADOCS_AI_FEATURES_ENABLED=false
LADOCS_AI_BLOCKNOTE_ENABLED=false
# Timeout in seconds for cross-node OIDC token and userinfo calls to Auther.
LADOCS_OIDC_TIMEOUT=15
