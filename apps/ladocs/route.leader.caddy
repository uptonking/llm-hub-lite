{$LADOCS_SITE} {
  import common_proxy
  reverse_proxy {$LADOCS_UPSTREAM} {
    transport http {
      tls_insecure_skip_verify
    }
    fail_duration 30s
    health_uri /api/v1.0/config/
    health_interval 30s
    health_timeout 15s
    health_fails 3
    health_passes 1
    header_up Host {http.reverse_proxy.upstream.hostport}
    header_up X-Forwarded-Host {$LADOCS_SITE_HOST}
    header_up X-Forwarded-Proto {scheme}
    header_up X-Forwarded-For {remote_host}
    import forward_verified_client_ip
  }
  handle_errors {
    @upstream_unavailable expression `{http.error.status_code} >= 500`
    respond @upstream_unavailable "ladocs unavailable" 503
  }
}
