MANIFEST_VERSION=5
APP_ID=ladocs
DISPLAY_NAME=Ladocs (La Suite Docs)
PLACEMENT=consumer
UPSTREAM_MODE=singleton
POLICY_FILE=cluster/apps/ladocs.policy
ORIGIN_HOST_KEY=NODE_LADOCS_ORIGIN_HOST
PUBLIC_ENDPOINTS=LADOCS_SITE|ladocs
LEADER_UPSTREAM_KEY=LADOCS_UPSTREAM
ROUTE_GROUPS=LADOCS_SITE|NODE_LADOCS_ORIGIN_HOST|LADOCS_UPSTREAM
RUNTIME_ENV_FILE=ladocs.env
RUNTIME_ENV_PROVISION=stage
CONFIG_FILE=config.env
CLUSTER_SECRET_KEYS=
NODE_SECRET_KEYS=LADOCS_DB_PASSWORD,LADOCS_DJANGO_SECRET_KEY,LADOCS_MINIO_ROOT_PASSWORD,LADOCS_Y_PROVIDER_API_KEY,LADOCS_OIDC_RP_CLIENT_SECRET
WOODPECKER_SECRET_NAMES=LADOCS_OIDC_RP_CLIENT_SECRET:auther_ladocs_oidc_secret
GENERATED_SECRET_KEYS=LADOCS_DB_PASSWORD,LADOCS_DJANGO_SECRET_KEY,LADOCS_MINIO_ROOT_PASSWORD,LADOCS_Y_PROVIDER_API_KEY
GENERATED_SECRET_BYTES=LADOCS_DB_PASSWORD:16,LADOCS_DJANGO_SECRET_KEY:32,LADOCS_MINIO_ROOT_PASSWORD:16,LADOCS_Y_PROVIDER_API_KEY:32
SECRET_MIN_LENGTHS=LADOCS_DB_PASSWORD:32,LADOCS_DJANGO_SECRET_KEY:64,LADOCS_MINIO_ROOT_PASSWORD:32,LADOCS_Y_PROVIDER_API_KEY:64,LADOCS_OIDC_RP_CLIENT_SECRET:32
ENV_KEYS=LADOCS_BACKEND_MEMORY_LIMIT,LADOCS_BACKEND_CPUS,LADOCS_BACKEND_PIDS_LIMIT,LADOCS_BACKEND_WORKERS,LADOCS_YHUB_MEMORY_LIMIT,LADOCS_YHUB_CPUS,LADOCS_YHUB_PIDS_LIMIT,LADOCS_YPROVIDER_MEMORY_LIMIT,LADOCS_YPROVIDER_CPUS,LADOCS_YPROVIDER_PIDS_LIMIT,LADOCS_FRONTEND_MEMORY_LIMIT,LADOCS_FRONTEND_CPUS,LADOCS_FRONTEND_PIDS_LIMIT,LADOCS_POSTGRES_MEMORY_LIMIT,LADOCS_POSTGRES_CPUS,LADOCS_POSTGRES_SHARED_BUFFERS,LADOCS_REDIS_MEMORY_LIMIT,LADOCS_REDIS_MAX_MEMORY,LADOCS_VALKEY_MEMORY_LIMIT,LADOCS_VALKEY_MAX_MEMORY,LADOCS_MINIO_MEMORY_LIMIT,LADOCS_MINIO_CPUS,LADOCS_BUCKET_NAME,LADOCS_MINIO_ROOT_USER,LADOCS_AI_FEATURES_ENABLED,LADOCS_AI_BLOCKNOTE_ENABLED
MOVE_MODE=fresh
STATE_MODE=files
RECOVERY_REQUIRED_PATHS=keys/private.pem,keys/yhub-private.pem,postgresql/pgdata/PG_VERSION,minio/.minio.sys
COMPOSE_FILE=compose.yml
COMPOSE_PROJECT=app-ladocs
SERVICE_NAME=ladocs-backend
NETWORK_ALIAS=ladocs-frontend
IMAGE_KEYS=LADOCS_BACKEND_IMAGE LADOCS_YHUB_IMAGE LADOCS_YPROVIDER_IMAGE LADOCS_FRONTEND_IMAGE LADOCS_POSTGRES_IMAGE LADOCS_REDIS_IMAGE LADOCS_VALKEY_IMAGE LADOCS_MINIO_IMAGE
DATA_ROOT_REL=ladocs
SQLITE_PATHS=
HEALTH_URL=/api/v1.0/config/
HEALTH_PORT=8083
HEALTH_EXPECT=RELEASE_VERSION
SMOKE_URL_KEY=LADOCS_SITE
SMOKE_LOCAL=healthcheck
HEALTH_MODE=healthcheck
HEALTH_SERVICE=
ROUTE_TEMPLATE_FOLLOWER=route.follower.caddy
ROUTE_TEMPLATE_LEADER=route.leader.caddy
