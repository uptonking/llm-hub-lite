{$GTEA_SITE} {
  import common_proxy
  reverse_proxy {$GTEA_UPSTREAM} {
    import forward_verified_client_ip
    transport http {
      tls_insecure_skip_verify
    }
    flush_interval -1
    health_uri /api/v1/version
    health_interval 10s
    health_timeout 5s
    health_fails 3
    health_passes 1
    header_up Host {http.reverse_proxy.upstream.hostport}
    header_up X-Forwarded-Host {$GTEA_SITE_HOST}
  }
  handle_errors {
    @upstream_unavailable expression `{http.error.status_code} >= 500`
    respond @upstream_unavailable "gtea unavailable" 503
  }
}
