MANIFEST_VERSION=5
APP_ID=gtea
DISPLAY_NAME=Gtea (Gitea)
PLACEMENT=consumer
UPSTREAM_MODE=singleton
POLICY_FILE=cluster/apps/gtea.policy
ORIGIN_HOST_KEY=NODE_GTEA_ORIGIN_HOST
PUBLIC_ENDPOINTS=GTEA_SITE|gtea
LEADER_UPSTREAM_KEY=GTEA_UPSTREAM
ROUTE_GROUPS=GTEA_SITE|NODE_GTEA_ORIGIN_HOST|GTEA_UPSTREAM
RUNTIME_ENV_FILE=gtea.env
CONFIG_FILE=config.env
CLUSTER_SECRET_KEYS=
NODE_SECRET_KEYS=GTEA_SECRET_KEY,GTEA_INTERNAL_TOKEN,GTEA_ADMIN_PASSWORD
GENERATED_SECRET_KEYS=GTEA_SECRET_KEY,GTEA_INTERNAL_TOKEN,GTEA_ADMIN_PASSWORD
GENERATED_SECRET_BYTES=GTEA_SECRET_KEY:32,GTEA_INTERNAL_TOKEN:32,GTEA_ADMIN_PASSWORD:16
SECRET_MIN_LENGTHS=GTEA_SECRET_KEY:64,GTEA_INTERNAL_TOKEN:64,GTEA_ADMIN_PASSWORD:32
SECRET_REGEXES=GTEA_SECRET_KEY:^[A-Fa-f0-9]{64}$,GTEA_INTERNAL_TOKEN:^[A-Fa-f0-9]{64}$,GTEA_ADMIN_PASSWORD:^[A-Fa-f0-9]{32}$
ENV_KEYS=GTEA_MEMORY_LIMIT,GTEA_CPUS,GTEA_PIDS_LIMIT,GTEA_APP_NAME,GTEA_ADMIN_USER,GTEA_ADMIN_EMAIL,GTEA_DISABLE_REGISTRATION,GTEA_REQUIRE_SIGNIN_VIEW,GTEA_DISABLE_SSH,GTEA_AUDIT_RECORD_OUTPUT,GTEA_AUDIT_RETENTION_DAYS
MOVE_MODE=fresh
STATE_MODE=sqlite
DATA_ROOT_REL=gtea
SQLITE_PATHS=data/gitea/gitea.db
RECOVERY_REQUIRED_PATHS=data/gitea/gitea.db
COMPOSE_FILE=compose.yml
COMPOSE_PROJECT=app-gtea
SERVICE_NAME=gtea
NETWORK_ALIAS=gtea
IMAGE_KEYS=GTEA_IMAGE
HEALTH_URL=/api/v1/version
HEALTH_PORT=3000
HEALTH_EXPECT="version":
SMOKE_URL_KEY=GTEA_SITE
SMOKE_LOCAL=healthcheck
HEALTH_MODE=healthcheck
HEALTH_SERVICE=
ROUTE_TEMPLATE_FOLLOWER=route.follower.caddy
ROUTE_TEMPLATE_LEADER=route.leader.caddy
# Gtea singleton consumer on worker-2
