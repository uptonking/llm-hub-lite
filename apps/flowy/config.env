FLOWY_MEMORY_LIMIT=768m
FLOWY_CPUS=0.75
FLOWY_PIDS_LIMIT=256
FLOWY_WORKER_CONCURRENCY=1
FLOWY_EXECUTION_MODE=SANDBOX_CODE_ONLY
FLOWY_REUSE_SANDBOX=true
FLOWY_PIECES_SYNC_MODE=OFFICIAL_AUTO
FLOWY_FILE_STORAGE_LOCATION=DB
FLOWY_S3_ENDPOINT=
FLOWY_S3_BUCKET=
FLOWY_S3_REGION=auto
FLOWY_S3_USE_SIGNED_URLS=true
FLOWY_AP_ENVIRONMENT=prod
FLOWY_CONFIG_PATH=/data/config
FLOWY_REDIS_TYPE=MEMORY
FLOWY_WEBHOOK_TIMEOUT_SECONDS=30
FLOWY_FLOW_TIMEOUT_SECONDS=600
FLOWY_EXECUTION_DATA_RETENTION_DAYS=7
FLOWY_PAUSED_FLOW_TIMEOUT_DAYS=7
FLOWY_TELEMETRY_ENABLED=false
FLOWY_PREWARM_CACHE_ON_STARTUP=false
FLOWY_DEFAULT_CONCURRENT_JOBS_LIMIT=1
FLOWY_SANDBOX_MEMORY_LIMIT=262144
FLOWY_RUNS_METADATA_UPDATE_CONCURRENCY=1
FLOWY_NODE_OPTIONS=--max-old-space-size=512
