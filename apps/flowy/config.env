FLOWY_MEMORY_LIMIT=1400m
FLOWY_CPUS=0.95
FLOWY_PIDS_LIMIT=256
FLOWY_WORKER_CONCURRENCY=1
FLOWY_LOG_LEVEL=warn
FLOWY_EXECUTION_MODE=SANDBOX_CODE_ONLY
# A single-node VPS should release the execution sandbox after each run. This
# avoids retaining piece modules in the long-lived worker process.
FLOWY_REUSE_SANDBOX=false
# Keep the bundled/database catalog stable on this single-user node. Automatic
# cloud synchronization downloads and reconciles the full catalog periodically;
# existing catalog rows remain available to the editor while this avoids a
# recurring CPU/memory spike on a 1-core VPS. Re-enable explicitly when adding
# newly published pieces is required.
FLOWY_PIECES_SYNC_MODE=NONE
FLOWY_FILE_STORAGE_LOCATION=DB
FLOWY_S3_ENDPOINT=
FLOWY_S3_BUCKET=
FLOWY_S3_REGION=auto
FLOWY_S3_USE_SIGNED_URLS=true
FLOWY_AP_ENVIRONMENT=prod
FLOWY_CONFIG_PATH=/data/config
FLOWY_REDIS_TYPE=MEMORY
FLOWY_WEBHOOK_TIMEOUT_SECONDS=30
FLOWY_FLOW_TIMEOUT_SECONDS=600
FLOWY_EXECUTION_DATA_RETENTION_DAYS=6
FLOWY_PAUSED_FLOW_TIMEOUT_DAYS=7
FLOWY_TELEMETRY_ENABLED=false
FLOWY_PREWARM_CACHE_ON_STARTUP=false
FLOWY_DEFAULT_CONCURRENT_JOBS_LIMIT=1
FLOWY_SANDBOX_MEMORY_LIMIT=262144
FLOWY_RUNS_METADATA_UPDATE_CONCURRENCY=1
# The API serves the complete piece catalog; 512 MB causes V8 OOMs while the
# editor loads pieces. Keep this below the 1.4 GB container cap for worker,
# PGlite, Redis-memory, and native allocations.
FLOWY_NODE_OPTIONS=--max-old-space-size=768
