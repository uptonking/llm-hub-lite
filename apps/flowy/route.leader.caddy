{$FLOWY_SITE} {
  import common_proxy
  reverse_proxy {$FLOWY_UPSTREAM} {
    health_uri /api/v1/health
    health_interval 10s
    health_timeout 10s
    health_fails 3
    health_passes 1
    header_up Host {http.reverse_proxy.upstream.hostport}
  }
  handle_errors {
    @upstream_unavailable expression `{http.error.status_code} >= 500`
    respond @upstream_unavailable "flowy unavailable" 503
  }
}
