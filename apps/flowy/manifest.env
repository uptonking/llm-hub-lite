MANIFEST_VERSION=5
APP_ID=flowy
DISPLAY_NAME=Flowy (Activepieces)
PLACEMENT=consumer
UPSTREAM_MODE=singleton
POLICY_FILE=cluster/apps/flowy.policy
ORIGIN_HOST_KEY=NODE_FLOWY_ORIGIN_HOST
PUBLIC_ENDPOINTS=FLOWY_SITE|flowy
LEADER_UPSTREAM_KEY=FLOWY_UPSTREAM
ROUTE_GROUPS=FLOWY_SITE|NODE_FLOWY_ORIGIN_HOST|FLOWY_UPSTREAM
RUNTIME_ENV_FILE=flowy.env
CONFIG_FILE=config.env
CLUSTER_SECRET_KEYS=
CONDITIONAL_SECRET_KEYS=FLOWY_FILE_STORAGE_LOCATION=S3|FLOWY_S3_ENDPOINT,FLOWY_S3_BUCKET,FLOWY_S3_ACCESS_KEY_ID,FLOWY_S3_SECRET_ACCESS_KEY
NODE_SECRET_KEYS=FLOWY_ENCRYPTION_KEY,FLOWY_JWT_SECRET
GENERATED_SECRET_KEYS=FLOWY_ENCRYPTION_KEY,FLOWY_JWT_SECRET
GENERATED_SECRET_BYTES=FLOWY_ENCRYPTION_KEY:16,FLOWY_JWT_SECRET:32
WOODPECKER_SECRET_NAMES=FLOWY_S3_ENDPOINT:FLOWY_S3_ENDPOINT,FLOWY_S3_BUCKET:FLOWY_S3_BUCKET,FLOWY_S3_ACCESS_KEY_ID:FLOWY_S3_ACCESS_KEY_ID,FLOWY_S3_SECRET_ACCESS_KEY:FLOWY_S3_SECRET_ACCESS_KEY
ENV_KEYS=FLOWY_MEMORY_LIMIT,FLOWY_CPUS,FLOWY_PIDS_LIMIT,FLOWY_WORKER_CONCURRENCY,FLOWY_LOG_LEVEL,FLOWY_EXECUTION_MODE,FLOWY_REUSE_SANDBOX,FLOWY_PIECES_SYNC_MODE,FLOWY_FILE_STORAGE_LOCATION,FLOWY_S3_ENDPOINT,FLOWY_S3_BUCKET,FLOWY_S3_REGION,FLOWY_S3_USE_SIGNED_URLS,FLOWY_AP_ENVIRONMENT,FLOWY_CONFIG_PATH,FLOWY_REDIS_TYPE,FLOWY_WEBHOOK_TIMEOUT_SECONDS,FLOWY_FLOW_TIMEOUT_SECONDS,FLOWY_EXECUTION_DATA_RETENTION_DAYS,FLOWY_PAUSED_FLOW_TIMEOUT_DAYS,FLOWY_TELEMETRY_ENABLED,FLOWY_PREWARM_CACHE_ON_STARTUP,FLOWY_DEFAULT_CONCURRENT_JOBS_LIMIT,FLOWY_SANDBOX_MEMORY_LIMIT,FLOWY_RUNS_METADATA_UPDATE_CONCURRENCY,FLOWY_NODE_OPTIONS
SECRET_MIN_LENGTHS=FLOWY_ENCRYPTION_KEY:32,FLOWY_JWT_SECRET:32
SECRET_REGEXES=FLOWY_ENCRYPTION_KEY:^[A-Fa-f0-9]{32}$
MOVE_MODE=fresh
STATE_MODE=pglite
PGLITE_PATH_REL=config/pglite
EPHEMERAL_DATA_REL=cache
COMPOSE_FILE=compose.yml
COMPOSE_PROJECT=app-flowy
SERVICE_NAME=flowy
NETWORK_ALIAS=flowy
IMAGE_KEYS=FLOWY_IMAGE
DATA_ROOT_REL=flowy
HEALTH_URL=/api/v1/health
HEALTH_EXPECT='"status":"Healthy"'
# The singleton is intentionally optimized for one low-concurrency user. Keep
# the catalog local unless an operator opts into an explicit cloud sync.
SMOKE_URL_KEY=FLOWY_SITE
SMOKE_LOCAL=healthcheck
HEALTH_MODE=healthcheck
HEALTH_SERVICE=
ROUTE_TEMPLATE_FOLLOWER=route.follower.caddy
ROUTE_TEMPLATE_LEADER=route.leader.caddy
