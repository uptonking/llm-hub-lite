MANIFEST_VERSION=3
APP_ID=observer
DISPLAY_NAME=OpenObserve
PLACEMENT=single-follower
UPSTREAM_MODE=singleton
POLICY_FILE=cluster/apps/observer.policy
TARGET_NODE_KEY=OBSERVER_TARGET_NODE_ID
ORIGIN_HOST_KEY=NODE_OBSERVER_ORIGIN_HOST
PUBLIC_URL_KEY=OBSERVER_SITE
PUBLIC_HOST=observer
LEADER_UPSTREAM_KEY=OBSERVER_UPSTREAM
ROUTE_GROUPS=OBSERVER_SITE|NODE_OBSERVER_ORIGIN_HOST|OBSERVER_UPSTREAM
RUNTIME_ENV_FILE=observer.env
SECRET_KEYS=OBSERVER_ROOT_USER_EMAIL,OBSERVER_ROOT_USER_PASSWORD
ENV_KEYS=OBSERVER_MEMORY_LIMIT,OBSERVER_CPUS,OBSERVER_PIDS_LIMIT,OBSERVER_QUERY_THREAD_NUM,OBSERVER_HTTP_WORKER_NUM,OBSERVER_HTTP_WORKER_MAX_BLOCKING,OBSERVER_GRPC_RUNTIME_WORKER_NUM,OBSERVER_GRPC_RUNTIME_BLOCKING_WORKER_NUM,OBSERVER_JOB_RUNTIME_WORKER_NUM,OBSERVER_JOB_RUNTIME_BLOCKING_WORKER_NUM,OBSERVER_WAL_RUNTIME_WORKER_NUM,OBSERVER_WAL_WRITE_QUEUE_SIZE,OBSERVER_DATA_RETENTION_DAYS,OBSERVER_COMPACT_INTERVAL,OBSERVER_COMPACT_DATA_RETENTION_INTERVAL,OBSERVER_COMPACT_TANTIVY_BUILDER_THREAD_NUM,OBSERVER_ENABLE_INVERTED_INDEX,OBSERVER_DISK_CACHE_MAX_SIZE,OBSERVER_LOG_ORGANIZATION,OBSERVER_LOG_STREAM,OBSERVER_LOG_BUFFER_MAX_BYTES,OBSERVER_LOG_PROXY_MEMORY_LIMIT,OBSERVER_LOG_PROXY_CPUS,OBSERVER_LOG_PROXY_PIDS_LIMIT,OBSERVER_LOG_SHIPPER_MEMORY_LIMIT,OBSERVER_LOG_SHIPPER_CPUS,OBSERVER_LOG_SHIPPER_PIDS_LIMIT
MOVE_MODE=fresh
STATE_MODE=files
COMPOSE_FILE=compose.yml
COMPOSE_PROJECT=app-observer
SERVICE_NAME=observer
NETWORK_ALIAS=observer
IMAGE_KEYS=OBSERVER_IMAGE OBSERVER_LOG_PROXY_IMAGE OBSERVER_LOG_SHIPPER_IMAGE HEALTH_PROBE_IMAGE
DATA_ROOT_REL=observer
EPHEMERAL_DATA_REL=log-buffer
HEALTH_URL=/healthz
HEALTH_EXPECT=Server up and running
SMOKE_URL_KEY=OBSERVER_SITE
SMOKE_LOCAL=healthcheck
HEALTH_MODE=healthcheck
HEALTH_SERVICE=health-probe
ROUTE_TEMPLATE_FOLLOWER=route.follower.caddy
ROUTE_TEMPLATE_LEADER=route.leader.caddy
