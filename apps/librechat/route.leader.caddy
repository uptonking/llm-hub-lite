{$LIBRECHAT_SITE} {
  import common_proxy
  reverse_proxy {$LIBRECHAT_UPSTREAMS} {
    transport http {
      tls_insecure_skip_verify
    }
    lb_policy random_choose 2
    lb_try_duration 5s
    lb_try_interval 250ms
    fail_duration 30s
    health_uri /health
    health_interval 10s
    health_timeout 3s
    header_up Host {http.reverse_proxy.upstream.hostport}
  }
}
{$LIBRECHAT_ADMIN_SITE} {
  import common_proxy
  reverse_proxy {$LIBRECHAT_ADMIN_UPSTREAMS} {
    transport http {
      tls_insecure_skip_verify
    }
    lb_policy random_choose 2
    lb_try_duration 5s
    lb_try_interval 250ms
    fail_duration 30s
    health_uri /
    health_interval 10s
    health_timeout 3s
    header_up Host {http.reverse_proxy.upstream.hostport}
  }
}
