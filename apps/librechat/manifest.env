MANIFEST_VERSION=5
APP_ID=librechat
DISPLAY_NAME=LibreChat
PLACEMENT=consumer
UPSTREAM_MODE=active-active
POLICY_FILE=cluster/apps/librechat.policy
CONFIG_FILE=config.env
PUBLIC_ENDPOINTS=LIBRECHAT_SITE|chat;LIBRECHAT_ADMIN_SITE|chat-admin
CLUSTER_SECRET_KEYS=LIBRECHAT_MONGO_URI,LIBRECHAT_REDIS_URI,LIBRECHAT_JWT_SECRET,LIBRECHAT_JWT_REFRESH_SECRET,LIBRECHAT_ADMIN_PANEL_SESSION_SECRET,LIBRECHAT_AWS_ENDPOINT_URL,LIBRECHAT_AWS_ACCESS_KEY_ID,LIBRECHAT_AWS_SECRET_ACCESS_KEY,LIBRECHAT_AWS_BUCKET_NAME
NODE_SECRET_KEYS=
GENERATED_SECRET_KEYS=LIBRECHAT_JWT_SECRET,LIBRECHAT_JWT_REFRESH_SECRET,LIBRECHAT_ADMIN_PANEL_SESSION_SECRET
SECRET_MIN_LENGTHS=LIBRECHAT_JWT_SECRET:32,LIBRECHAT_JWT_REFRESH_SECRET:32,LIBRECHAT_ADMIN_PANEL_SESSION_SECRET:32
ENV_KEYS=LIBRECHAT_AWS_REGION,LIBRECHAT_AWS_FORCE_PATH_STYLE,LIBRECHAT_FILE_STRATEGY,LIBRECHAT_ALLOW_REGISTRATION,LIBRECHAT_USE_REDIS,LIBRECHAT_USE_REDIS_STREAMS,LIBRECHAT_SEARCH,LIBRECHAT_API_MEMORY_LIMIT,LIBRECHAT_API_CPUS,LIBRECHAT_API_PIDS_LIMIT,LIBRECHAT_API_NODE_OPTIONS,LIBRECHAT_ADMIN_MEMORY_LIMIT,LIBRECHAT_ADMIN_CPUS,LIBRECHAT_ADMIN_PIDS_LIMIT,LIBRECHAT_ADMIN_NODE_OPTIONS,LIBRECHAT_CLIENT_MEMORY_LIMIT,LIBRECHAT_CLIENT_CPUS,LIBRECHAT_CLIENT_PIDS_LIMIT,LIBRECHAT_MONGO_MAX_POOL_SIZE,LIBRECHAT_MONGO_MIN_POOL_SIZE,LIBRECHAT_MONGO_MAX_CONNECTING,LIBRECHAT_MONGO_MAX_IDLE_TIME_MS,LIBRECHAT_MONGO_WAIT_QUEUE_TIMEOUT_MS,LIBRECHAT_MONGO_AUTO_INDEX,LIBRECHAT_MONGO_AUTO_CREATE,LIBRECHAT_REDIS_KEY_PREFIX,LIBRECHAT_REDIS_MAX_LISTENERS,LIBRECHAT_REDIS_RETRY_MAX_DELAY,LIBRECHAT_REDIS_RETRY_MAX_ATTEMPTS,LIBRECHAT_REDIS_CONNECT_TIMEOUT,LIBRECHAT_REDIS_ENABLE_OFFLINE_QUEUE,LIBRECHAT_REDIS_PING_INTERVAL,LIBRECHAT_USE_REDIS_CLUSTER,LIBRECHAT_REDIS_CLUSTER_SAFE_DELETE,LIBRECHAT_REDIS_DELETE_CHUNK_SIZE,LIBRECHAT_REDIS_UPDATE_CHUNK_SIZE,LIBRECHAT_REDIS_SCAN_COUNT,LIBRECHAT_FORCED_IN_MEMORY_CACHE_NAMESPACES,LIBRECHAT_MCP_REGISTRY_CACHE_TTL,LIBRECHAT_STREAM_DELTA_COALESCE_MS,LIBRECHAT_MCP_INIT_TIMEOUT_MS,LIBRECHAT_SCHEDULES_DISABLED,LIBRECHAT_DEPLOYMENT_PLUGIN_HOOKS,LIBRECHAT_CODE_SANDBOX_PREWARM,LIBRECHAT_FILE_UPLOAD_SSE_ENABLED,LIBRECHAT_FILE_UPLOAD_IP_MAX,LIBRECHAT_FILE_UPLOAD_IP_WINDOW,LIBRECHAT_FILE_UPLOAD_USER_MAX,LIBRECHAT_FILE_UPLOAD_USER_WINDOW,LIBRECHAT_CONVERSATION_IMPORT_MAX_FILE_SIZE_BYTES,LIBRECHAT_OTEL_SDK_DISABLED,LIBRECHAT_CONSOLE_JSON
ROUTE_GROUPS=LIBRECHAT_SITE|NODE_LIBRECHAT_ORIGIN_HOST|LIBRECHAT_UPSTREAMS;LIBRECHAT_ADMIN_SITE|NODE_LIBRECHAT_ADMIN_ORIGIN_HOST|LIBRECHAT_ADMIN_UPSTREAMS
COMPOSE_FILE=compose.yml
COMPOSE_PROJECT=app-librechat
SERVICE_NAME=librechat-api
NETWORK_ALIAS=librechat-client
IMAGE_KEYS=LIBRECHAT_API_IMAGE LIBRECHAT_ADMIN_IMAGE LIBRECHAT_CLIENT_IMAGE
DATA_ROOT_REL=librechat
SQLITE_PATHS=
HEALTH_URL=/health
HEALTH_EXPECT=OK
SMOKE_URL_KEY=LIBRECHAT_SITE
SMOKE_LOCAL=healthcheck
HEALTH_MODE=healthcheck
ROUTE_TEMPLATE_FOLLOWER=route.follower.caddy
ROUTE_TEMPLATE_LEADER=route.leader.caddy
