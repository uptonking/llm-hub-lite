MANIFEST_VERSION=2
APP_ID=librechat
PLACEMENT=follower
COMPOSE_FILE=compose.yml
COMPOSE_PROJECT=app-librechat
SERVICE_NAME=librechat-api
NETWORK_ALIAS=librechat-client
IMAGE_KEYS=LIBRECHAT_API_IMAGE LIBRECHAT_ADMIN_IMAGE LIBRECHAT_CLIENT_IMAGE
