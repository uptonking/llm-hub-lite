MANIFEST_VERSION=5
APP_ID=verge6
DISPLAY_NAME=Verge6 (Hysteria)
PLACEMENT=consumer
UPSTREAM_MODE=singleton
INGRESS_MODE=direct
DIRECT_LISTENERS=udp:443:443
DIRECT_PORT_RANGES=udp:20000:30000:443
DIRECT_PROBE=socket
POLICY_FILE=cluster/apps/verge6.policy
PUBLIC_ENDPOINTS=VERGE6_SITE|verge6
RUNTIME_ENV_FILE=verge6.env
RUNTIME_ENV_PROVISION=stage
RUNTIME_CONFIG_TEMPLATE=config.yaml.tmpl
RUNTIME_CONFIG_FILE=runtime/verge6/config.yaml
CONFIG_FILE=config.env
CLUSTER_SECRET_KEYS=
NODE_SECRET_KEYS=VERGE6_AUTH_PASSWORD,VERGE6_CLOUDFLARE_API_TOKEN
WOODPECKER_SECRET_NAMES=VERGE6_CLOUDFLARE_API_TOKEN:verge_cloudflare_api_token
GENERATED_SECRET_KEYS=VERGE6_AUTH_PASSWORD
GENERATED_SECRET_BYTES=VERGE6_AUTH_PASSWORD:32
SECRET_MIN_LENGTHS=VERGE6_AUTH_PASSWORD:32,VERGE6_CLOUDFLARE_API_TOKEN:20
ENV_KEYS=VERGE6_MEMORY_LIMIT,VERGE6_CPUS,VERGE6_PIDS_LIMIT,VERGE6_LOG_LEVEL,VERGE6_GOMAXPROCS,VERGE6_GOMEMLIMIT,VERGE6_DOMAIN,VERGE6_ACME_EMAIL
MOVE_MODE=fresh
STATE_MODE=files
COMPOSE_FILE=compose.yml
COMPOSE_PROJECT=app-verge6
SERVICE_NAME=verge6
NETWORK_ALIAS=verge6
IMAGE_KEYS=VERGE6_IMAGE
DATA_ROOT_REL=verge6
HEALTH_URL=/
SMOKE_URL_KEY=VERGE6_SITE
SMOKE_LOCAL=healthcheck
HEALTH_MODE=process
HEALTH_SERVICE=
