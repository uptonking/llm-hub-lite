listen: :443,20000-30000
acme:
  domains:
    - verge6.aichorage.de
  email: __VERGE6_ACME_EMAIL__
  type: dns
  dns:
    name: cloudflare
    config:
      cloudflare_api_token: __VERGE6_CLOUDFLARE_API_TOKEN__
auth:
  type: password
  password: __VERGE6_AUTH_PASSWORD__
ignoreClientBandwidth: true
quic:
  initStreamReceiveWindow: 8388608
  maxStreamReceiveWindow: 8388608
  initConnReceiveWindow: 20971520
  maxConnReceiveWindow: 20971520
  maxIdleTimeout: 60s
  keepAlivePeriod: 10s
masquerade:
  type: proxy
  proxy:
    url: https://www.aichorage.de/
outbounds:
  - name: default
    type: direct
    direct:
      mode: 4
      fastOpen: true
