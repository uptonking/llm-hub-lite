MANIFEST_VERSION=5
APP_ID=verge
DISPLAY_NAME=Verge (Hysteria)
PLACEMENT=consumer
UPSTREAM_MODE=singleton
INGRESS_MODE=direct
DIRECT_LISTENERS=udp:443:443
DIRECT_PROBE=socket
POLICY_FILE=cluster/apps/verge.policy
PUBLIC_ENDPOINTS=VERGE_SITE|verge
RUNTIME_ENV_FILE=verge.env
# Runtime credentials are supplied by the staging workflow on first deploy.
RUNTIME_ENV_PROVISION=stage
RUNTIME_CONFIG_TEMPLATE=config.yaml.tmpl
CONFIG_FILE=config.env
CLUSTER_SECRET_KEYS=
NODE_SECRET_KEYS=VERGE_AUTH_PASSWORD,VERGE_CLOUDFLARE_API_TOKEN
GENERATED_SECRET_KEYS=VERGE_AUTH_PASSWORD
GENERATED_SECRET_BYTES=VERGE_AUTH_PASSWORD:32
SECRET_MIN_LENGTHS=VERGE_AUTH_PASSWORD:32,VERGE_CLOUDFLARE_API_TOKEN:20
ENV_KEYS=VERGE_MEMORY_LIMIT,VERGE_CPUS,VERGE_PIDS_LIMIT,VERGE_LOG_LEVEL,VERGE_GOMAXPROCS,VERGE_GOMEMLIMIT,VERGE_DOMAIN,VERGE_ACME_EMAIL
MOVE_MODE=fresh
STATE_MODE=files
COMPOSE_FILE=compose.yml
COMPOSE_PROJECT=app-verge
SERVICE_NAME=verge
NETWORK_ALIAS=verge
IMAGE_KEYS=VERGE_IMAGE
DATA_ROOT_REL=verge
HEALTH_URL=/
SMOKE_URL_KEY=VERGE_SITE
SMOKE_LOCAL=healthcheck
HEALTH_MODE=process
HEALTH_SERVICE=
