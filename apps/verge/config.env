VERGE_MEMORY_LIMIT=512m
VERGE_CPUS=0.5
VERGE_PIDS_LIMIT=64
VERGE_LOG_LEVEL=warn
VERGE_GOMAXPROCS=1
VERGE_GOMEMLIMIT=450MiB
VERGE_DOMAIN=verge.aichorage.de
VERGE_ACME_EMAIL=admin@aichorage.de
# DNS-01 certificate issuance uses the protected worker-local Cloudflare token.
# Runtime secrets are reconciled during the follower staging transaction.
# Keep the runtime file absent until that transaction completes successfully.
# Caddy UDP/443 is reserved for this direct listener on the selected follower.
# Direct singleton publication uses a local socket smoke check.
# Image prefetch is performed for direct publication transactions.
# Cleanup on non-target followers is idempotent when Verge is absent.
# Descriptor validation tolerates followers without an installed app release.
