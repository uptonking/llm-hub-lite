MANIFEST_VERSION=5
APP_ID=cpapi
DISPLAY_NAME=CPAPI
PLACEMENT=consumer
UPSTREAM_MODE=singleton
POLICY_FILE=cluster/apps/cpapi.policy
ORIGIN_HOST_KEY=NODE_CPAPI_ORIGIN_HOST
PUBLIC_ENDPOINTS=CPAPI_SITE|cpapi
LEADER_UPSTREAM_KEY=CPAPI_UPSTREAM
ROUTE_GROUPS=CPAPI_SITE|NODE_CPAPI_ORIGIN_HOST|CPAPI_UPSTREAM
RUNTIME_ENV_FILE=cpapi.env
CONFIG_FILE=config.env
CLUSTER_SECRET_KEYS=
NODE_SECRET_KEYS=CPAPI_API_KEY,CPAPI_MANAGEMENT_KEY
GENERATED_SECRET_KEYS=CPAPI_API_KEY,CPAPI_MANAGEMENT_KEY
ENV_KEYS=CPAPI_MEMORY_LIMIT,CPAPI_CPUS,CPAPI_PIDS_LIMIT,CPAPI_GOMAXPROCS,CPAPI_GOMEMLIMIT,CPAPI_LOGGING_TO_FILE,CPAPI_LOGS_MAX_TOTAL_SIZE_MB,CPAPI_PLUGINS_ENABLED
MOVE_MODE=fresh
STATE_MODE=files
COMPOSE_FILE=compose.yml
COMPOSE_PROJECT=app-cpapi
SERVICE_NAME=cpapi
NETWORK_ALIAS=cpapi
IMAGE_KEYS=CPAPI_IMAGE HEALTH_PROBE_IMAGE
DATA_ROOT_REL=cpapi
CONFIG_RESET_MARKER_REL=.reset-config
HEALTH_URL=/healthz
HEALTH_EXPECT='"status":"ok"'
SMOKE_URL_KEY=CPAPI_SITE
SMOKE_LOCAL=healthcheck
HEALTH_MODE=healthcheck
HEALTH_SERVICE=health-probe
ROUTE_TEMPLATE_FOLLOWER=route.follower.caddy
ROUTE_TEMPLATE_LEADER=route.leader.caddy
