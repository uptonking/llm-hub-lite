MANIFEST_VERSION=3
APP_ID=cpapi
DISPLAY_NAME=CPAPI
PLACEMENT=single-follower
UPSTREAM_MODE=singleton
POLICY_FILE=cluster/apps/cpapi.policy
TARGET_NODE_KEY=CPAPI_TARGET_NODE_ID
ORIGIN_HOST_KEY=NODE_CPAPI_ORIGIN_HOST
PUBLIC_URL_KEY=CPAPI_SITE
PUBLIC_HOST=cpapi
LEADER_UPSTREAM_KEY=CPAPI_UPSTREAM
ROUTE_GROUPS=CPAPI_SITE|NODE_CPAPI_ORIGIN_HOST|CPAPI_UPSTREAM
RUNTIME_ENV_FILE=cpapi.env
SECRET_KEYS=CPAPI_API_KEY,CPAPI_MANAGEMENT_KEY
ENV_KEYS=CPAPI_MEMORY_LIMIT,CPAPI_CPUS,CPAPI_PIDS_LIMIT,CPAPI_GOMAXPROCS,CPAPI_GOMEMLIMIT
MOVE_MODE=fresh
STATE_MODE=files
COMPOSE_FILE=compose.yml
COMPOSE_PROJECT=app-cpapi
SERVICE_NAME=cpapi
NETWORK_ALIAS=cpapi
IMAGE_KEYS=CPAPI_IMAGE
DATA_ROOT_REL=cpapi
CONFIG_RESET_MARKER_REL=.reset-config
HEALTH_URL=/management.html
HEALTH_EXPECT=
SMOKE_URL_KEY=CPAPI_SITE
SMOKE_LOCAL=healthcheck
HEALTH_MODE=process
ROUTE_TEMPLATE_FOLLOWER=route.follower.caddy
ROUTE_TEMPLATE_LEADER=route.leader.caddy
