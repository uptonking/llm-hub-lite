CPAPI_MEMORY_LIMIT=256m
CPAPI_CPUS=0.25
CPAPI_PIDS_LIMIT=128
CPAPI_GOMAXPROCS=1
CPAPI_GOMEMLIMIT=192MiB
# Persist CPAPI's access log under /runtime/logs with bounded retention. Access
# lines contain the canonical client IP; full request/response logs stay off.
CPAPI_LOGGING_TO_FILE=true
CPAPI_LOGS_MAX_TOTAL_SIZE_MB=50
# Plugins are trusted in-process code; keep the global host enabled while
# individual plugins remain opt-in through CPAPI's management configuration.
# Consumer staging force-recreates CPAPI so this seed reaches the runtime file.
CPAPI_PLUGINS_ENABLED=true
