MANIFEST_VERSION=5
APP_ID=relaichor1
DISPLAY_NAME=Relaichor1 (Paseo Relay Go)
PLACEMENT=consumer
UPSTREAM_MODE=singleton
POLICY_FILE=cluster/apps/relaichor1.policy
ORIGIN_HOST_KEY=NODE_RELAICHOR1_ORIGIN_HOST
PUBLIC_ENDPOINTS=RELAICHOR1_SITE|relaichor1
LEADER_UPSTREAM_KEY=RELAICHOR1_UPSTREAM
ROUTE_GROUPS=RELAICHOR1_SITE|NODE_RELAICHOR1_ORIGIN_HOST|RELAICHOR1_UPSTREAM
RUNTIME_ENV_FILE=
CONFIG_FILE=config.env
CLUSTER_SECRET_KEYS=
NODE_SECRET_KEYS=
OPTIONAL_SECRET_KEYS=
GENERATED_SECRET_KEYS=
WOODPECKER_SECRET_NAMES=
ENV_KEYS=RELAICHOR1_MEMORY_LIMIT,RELAICHOR1_CPUS,RELAICHOR1_PIDS_LIMIT,RELAICHOR1_ADDR,RELAICHOR1_LOG_FORMAT,RELAICHOR1_MAX_BUFFER_FRAMES
MOVE_MODE=fresh
STATE_MODE=ephemeral
COMPOSE_FILE=compose.yml
COMPOSE_PROJECT=app-relaichor1
SERVICE_NAME=relaichor1
NETWORK_ALIAS=relaichor1
IMAGE_KEYS=RELAICHOR1_IMAGE HEALTH_PROBE_IMAGE
DATA_ROOT_REL=
HEALTH_URL=/health
HEALTH_PORT=8411
HEALTH_EXPECT="\"status\":\"ok\""
SMOKE_URL_KEY=RELAICHOR1_SITE
SMOKE_LOCAL=healthcheck
HEALTH_MODE=process
HEALTH_SERVICE=health-probe
ROUTE_TEMPLATE_FOLLOWER=route.follower.caddy
ROUTE_TEMPLATE_LEADER=route.leader.caddy
