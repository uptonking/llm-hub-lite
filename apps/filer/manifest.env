MANIFEST_VERSION=5
APP_ID=filer
DISPLAY_NAME=Filer (FileBrowser)
PLACEMENT=consumer
UPSTREAM_MODE=singleton
POLICY_FILE=cluster/apps/filer.policy
ORIGIN_HOST_KEY=NODE_FILER_ORIGIN_HOST
PUBLIC_ENDPOINTS=FILER_SITE|filer
LEADER_UPSTREAM_KEY=FILER_UPSTREAM
ROUTE_GROUPS=FILER_SITE|NODE_FILER_ORIGIN_HOST|FILER_UPSTREAM
RUNTIME_ENV_FILE=filer.env
RUNTIME_ENV_PROVISION=stage
CONFIG_FILE=config.env
CLUSTER_SECRET_KEYS=
NODE_SECRET_KEYS=FILER_ADMIN_PASSWORD
GENERATED_SECRET_KEYS=FILER_ADMIN_PASSWORD
GENERATED_SECRET_BYTES=FILER_ADMIN_PASSWORD:16
SECRET_MIN_LENGTHS=FILER_ADMIN_PASSWORD:32
SECRET_REGEXES=FILER_ADMIN_PASSWORD:^[A-Fa-f0-9]{32}$
ENV_KEYS=FILER_MEMORY_LIMIT,FILER_CPUS,FILER_PIDS_LIMIT,FILER_ADMIN_USER
MOVE_MODE=fresh
STATE_MODE=sqlite
DATA_ROOT_REL=filer
SQLITE_PATHS=data/database.sqlite
RECOVERY_REQUIRED_PATHS=data/database.sqlite
COMPOSE_FILE=compose.yml
COMPOSE_PROJECT=app-filer
SERVICE_NAME=filer
NETWORK_ALIAS=filer
IMAGE_KEYS=FILER_IMAGE
HEALTH_URL=/health
HEALTH_PORT=80
HEALTH_EXPECT="message":"ok"
SMOKE_URL_KEY=FILER_SITE
SMOKE_LOCAL=healthcheck
HEALTH_MODE=healthcheck
HEALTH_SERVICE=
ROUTE_TEMPLATE_FOLLOWER=route.follower.caddy
ROUTE_TEMPLATE_LEADER=route.leader.caddy
