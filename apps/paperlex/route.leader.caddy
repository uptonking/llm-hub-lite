{$PAPERLEX_SITE} {
  import common_proxy
  header {
    Referrer-Policy same-origin
  }
  @null_origin header Origin null
  request_header @null_origin -Origin
  reverse_proxy {$PAPERLEX_UPSTREAM} {
    transport http {
      tls_insecure_skip_verify
    }
    fail_duration 30s
    health_uri /accounts/login/
    health_interval 15s
    health_timeout 5s
    health_fails 3
    health_passes 1
    header_up Host {http.reverse_proxy.upstream.hostport}
    header_up X-Forwarded-Host {$PAPERLEX_SITE_HOST}
    header_up X-Forwarded-Proto {scheme}
    header_up X-Forwarded-For {remote_host}
    import forward_verified_client_ip
  }
  handle_errors {
    @upstream_unavailable expression `{http.error.status_code} >= 500`
    respond @upstream_unavailable "paperlex unavailable" 503
  }
}
