MANIFEST_VERSION=5
APP_ID=paperlex
DISPLAY_NAME=Paperlex (Paperless-ngx)
PLACEMENT=consumer
UPSTREAM_MODE=singleton
POLICY_FILE=cluster/apps/paperlex.policy
ORIGIN_HOST_KEY=NODE_PAPERLEX_ORIGIN_HOST
PUBLIC_ENDPOINTS=PAPERLEX_SITE|paperlex
LEADER_UPSTREAM_KEY=PAPERLEX_UPSTREAM
ROUTE_GROUPS=PAPERLEX_SITE|NODE_PAPERLEX_ORIGIN_HOST|PAPERLEX_UPSTREAM
RUNTIME_ENV_FILE=paperlex.env
RUNTIME_ENV_PROVISION=stage
CONFIG_FILE=config.env
CLUSTER_SECRET_KEYS=
NODE_SECRET_KEYS=PAPERLEX_SECRET_KEY,PAPERLEX_ADMIN_PASSWORD
GENERATED_SECRET_KEYS=PAPERLEX_SECRET_KEY,PAPERLEX_ADMIN_PASSWORD
GENERATED_SECRET_BYTES=PAPERLEX_SECRET_KEY:32,PAPERLEX_ADMIN_PASSWORD:16
SECRET_MIN_LENGTHS=PAPERLEX_SECRET_KEY:64,PAPERLEX_ADMIN_PASSWORD:32
SECRET_REGEXES=PAPERLEX_SECRET_KEY:^[A-Fa-f0-9]{64}$,PAPERLEX_ADMIN_PASSWORD:^[A-Fa-f0-9]{32}$
ENV_KEYS=PAPERLEX_MEMORY_LIMIT,PAPERLEX_CPUS,PAPERLEX_PIDS_LIMIT,PAPERLEX_REDIS_MEMORY_LIMIT,PAPERLEX_REDIS_CPUS,PAPERLEX_REDIS_MAX_MEMORY,PAPERLEX_ADMIN_USER,PAPERLEX_ADMIN_MAIL,PAPERLEX_TIME_ZONE,PAPERLEX_OCR_LANGUAGE,PAPERLEX_OCR_MODE,PAPERLEX_ARCHIVE_FILE_GENERATION,PAPERLEX_DB_TIMEOUT,PAPERLEX_WEBSERVER_WORKERS,PAPERLEX_TASK_WORKERS,PAPERLEX_THREADS_PER_WORKER,PAPERLEX_TIKA_ENABLED,PAPERLEX_AI_ENABLED,PAPERLEX_CONSUMER_POLLING_INTERVAL,PAPERLEX_ENABLE_UPDATE_CHECK,PAPERLEX_ACCOUNT_ALLOW_SIGNUPS
MOVE_MODE=fresh
STATE_MODE=files
RECOVERY_REQUIRED_PATHS=data/db.sqlite3
COMPOSE_FILE=compose.yml
COMPOSE_PROJECT=app-paperlex
SERVICE_NAME=paperlex
NETWORK_ALIAS=paperlex
IMAGE_KEYS=PAPERLEX_IMAGE PAPERLEX_REDIS_IMAGE
DATA_ROOT_REL=paperlex
SQLITE_PATHS=data/db.sqlite3
HEALTH_URL=/accounts/login/
HEALTH_PORT=8000
HEALTH_EXPECT=Paperless-ngx
SMOKE_URL_KEY=PAPERLEX_SITE
SMOKE_LOCAL=healthcheck
HEALTH_MODE=healthcheck
HEALTH_SERVICE=
ROUTE_TEMPLATE_FOLLOWER=route.follower.caddy
ROUTE_TEMPLATE_LEADER=route.leader.caddy
