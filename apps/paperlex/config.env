# Single-node minimal CPU/RAM profile for Paperless-ngx on a shared follower VPS.
PAPERLEX_MEMORY_LIMIT=1024m
PAPERLEX_CPUS=0.85
PAPERLEX_PIDS_LIMIT=256
PAPERLEX_REDIS_MEMORY_LIMIT=64m
PAPERLEX_REDIS_CPUS=0.15
PAPERLEX_REDIS_MAX_MEMORY=48mb
PAPERLEX_ADMIN_USER=admin
PAPERLEX_ADMIN_MAIL=admin@aichorage.de
PAPERLEX_TIME_ZONE=Asia/Shanghai
PAPERLEX_OCR_LANGUAGE=eng
PAPERLEX_OCR_MODE=skip
PAPERLEX_WEBSERVER_WORKERS=1
PAPERLEX_TASK_WORKERS=1
PAPERLEX_THREADS_PER_WORKER=1
PAPERLEX_TIKA_ENABLED=false
PAPERLEX_AI_ENABLED=false
PAPERLEX_CONSUMER_POLLING_INTERVAL=0
PAPERLEX_ENABLE_UPDATE_CHECK=false
PAPERLEX_ACCOUNT_ALLOW_SIGNUPS=false
