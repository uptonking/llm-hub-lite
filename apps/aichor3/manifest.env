MANIFEST_VERSION=5
APP_ID=aichor3
DISPLAY_NAME=Aichor3 (Paseo)
PLACEMENT=consumer
UPSTREAM_MODE=singleton
POLICY_FILE=cluster/apps/aichor3.policy
ORIGIN_HOST_KEY=NODE_AICHOR3_ORIGIN_HOST
PUBLIC_ENDPOINTS=AICHOR3_SITE|aichor3
LEADER_UPSTREAM_KEY=AICHOR3_UPSTREAM
ROUTE_GROUPS=AICHOR3_SITE|NODE_AICHOR3_ORIGIN_HOST|AICHOR3_UPSTREAM
RUNTIME_ENV_FILE=aichor3.env
RUNTIME_ENV_PROVISION=stage
CONFIG_FILE=config.env
CLUSTER_SECRET_KEYS=
NODE_SECRET_KEYS=AICHOR3_PASSWORD
CONDITIONAL_SECRET_KEYS=AICHOR3_PI_OPENAI_ENABLED=true|AICHOR3_PI_OPENAI_API_KEY;AICHOR3_PI_ANTHROPIC_ENABLED=true|AICHOR3_PI_ANTHROPIC_API_KEY;AICHOR3_PI_OPENROUTER_ENABLED=true|AICHOR3_PI_OPENROUTER_API_KEY
WOODPECKER_SECRET_NAMES=AICHOR3_PASSWORD:aichor3_password,AICHOR3_PI_OPENAI_API_KEY:AICHOR3_PI_OPENAI_API_KEY,AICHOR3_PI_ANTHROPIC_API_KEY:AICHOR3_PI_ANTHROPIC_API_KEY,AICHOR3_PI_OPENROUTER_API_KEY:AICHOR3_PI_OPENROUTER_API_KEY
GENERATED_SECRET_KEYS=AICHOR3_PASSWORD
GENERATED_SECRET_BYTES=AICHOR3_PASSWORD:32
SECRET_MIN_LENGTHS=AICHOR3_PASSWORD:32
ENV_KEYS=AICHOR3_MEMORY_LIMIT,AICHOR3_CPUS,AICHOR3_PIDS_LIMIT,AICHOR3_LOG_LEVEL,AICHOR3_LOG_FORMAT,AICHOR3_HOSTNAMES,AICHOR3_TRUSTED_PROXIES,AICHOR3_CORS_ORIGINS,AICHOR3_PI_OPENAI_ENABLED,AICHOR3_PI_ANTHROPIC_ENABLED,AICHOR3_PI_OPENROUTER_ENABLED
MOVE_MODE=fresh
STATE_MODE=files
RECOVERY_REQUIRED_PATHS=.paseo/server-id,.paseo/daemon-keypair.json,.paseo/config.json
COMPOSE_FILE=compose.yml
COMPOSE_PROJECT=app-aichor3
SERVICE_NAME=aichor3
NETWORK_ALIAS=aichor3
IMAGE_KEYS=AICHOR_IMAGE
DATA_ROOT_REL=aichor3
HEALTH_URL=/api/health
HEALTH_PORT=6767
HEALTH_EXPECT='"status":"ok"'
SMOKE_URL_KEY=AICHOR3_SITE
SMOKE_LOCAL=healthcheck
HEALTH_MODE=healthcheck
HEALTH_SERVICE=
ROUTE_TEMPLATE_FOLLOWER=route.follower.caddy
ROUTE_TEMPLATE_LEADER=route.leader.caddy
