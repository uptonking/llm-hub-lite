MANIFEST_VERSION=5
APP_ID=cpamp
DISPLAY_NAME=CPAMP
PLACEMENT=consumer
UPSTREAM_MODE=singleton
POLICY_FILE=cluster/apps/cpamp.policy
ORIGIN_HOST_KEY=NODE_CPAMP_ORIGIN_HOST
PUBLIC_ENDPOINTS=CPAMP_SITE|cpamp
LEADER_UPSTREAM_KEY=CPAMP_UPSTREAM
ROUTE_GROUPS=CPAMP_SITE|NODE_CPAMP_ORIGIN_HOST|CPAMP_UPSTREAM
RUNTIME_ENV_FILE=cpamp.env
CONFIG_FILE=config.env
CLUSTER_SECRET_KEYS=
NODE_SECRET_KEYS=CPAMP_ADMIN_KEY
GENERATED_SECRET_KEYS=CPAMP_ADMIN_KEY
GENERATED_SECRET_BYTES=CPAMP_ADMIN_KEY:32
SECRET_REGEXES=CPAMP_ADMIN_KEY:^[A-Fa-f0-9]{64}$
ENV_KEYS=CPAMP_MEMORY_LIMIT,CPAMP_CPUS,CPAMP_PIDS_LIMIT,CPAMP_USAGE_CORS_ORIGINS
MOVE_MODE=fresh
STATE_MODE=sqlite
COMPOSE_FILE=compose.yml
COMPOSE_PROJECT=app-cpamp
SERVICE_NAME=cpamp
NETWORK_ALIAS=cpamp
IMAGE_KEYS=CPAMP_IMAGE HEALTH_PROBE_IMAGE
DATA_ROOT_REL=cpamp
SQLITE_PATHS=usage.sqlite
HEALTH_URL=/health
HEALTH_PORT=18317
HEALTH_EXPECT='"ok":true'
SMOKE_URL_KEY=CPAMP_SITE
SMOKE_LOCAL=healthcheck
HEALTH_MODE=healthcheck
HEALTH_SERVICE=health-probe
ROUTE_TEMPLATE_FOLLOWER=route.follower.caddy
ROUTE_TEMPLATE_LEADER=route.leader.caddy
