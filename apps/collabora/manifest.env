MANIFEST_VERSION=5
APP_ID=collabora
DISPLAY_NAME=Collabora
PLACEMENT=consumer
UPSTREAM_MODE=singleton
POLICY_FILE=cluster/apps/collabora.policy
ORIGIN_HOST_KEY=NODE_COLLABORA_ORIGIN_HOST
PUBLIC_ENDPOINTS=COLLABORA_SITE|collabora
LEADER_UPSTREAM_KEY=COLLABORA_UPSTREAM
ROUTE_GROUPS=COLLABORA_SITE|NODE_COLLABORA_ORIGIN_HOST|COLLABORA_UPSTREAM
RUNTIME_ENV_FILE=collabora.env
RUNTIME_ENV_PROVISION=stage
CONFIG_FILE=config.env
CLUSTER_SECRET_KEYS=
NODE_SECRET_KEYS=COLLABORA_ADMIN_PASSWORD
GENERATED_SECRET_KEYS=COLLABORA_ADMIN_PASSWORD
GENERATED_SECRET_BYTES=COLLABORA_ADMIN_PASSWORD:16
SECRET_MIN_LENGTHS=COLLABORA_ADMIN_PASSWORD:32
SECRET_REGEXES=COLLABORA_ADMIN_PASSWORD:^[A-Fa-f0-9]{32}$
ENV_KEYS=COLLABORA_MEMORY_LIMIT,COLLABORA_CPUS,COLLABORA_PIDS_LIMIT,COLLABORA_ADMIN_USER
MOVE_MODE=fresh
STATE_MODE=ephemeral
COMPOSE_FILE=compose.yml
COMPOSE_PROJECT=app-collabora
SERVICE_NAME=collabora
NETWORK_ALIAS=collabora
IMAGE_KEYS=COLLABORA_IMAGE
DATA_ROOT_REL=
HEALTH_URL=/hosting/discovery
HEALTH_PORT=9980
HEALTH_EXPECT=wopi-discovery
SMOKE_URL_KEY=COLLABORA_SITE
SMOKE_LOCAL=healthcheck
HEALTH_MODE=healthcheck
HEALTH_SERVICE=
ROUTE_TEMPLATE_FOLLOWER=route.follower.caddy
ROUTE_TEMPLATE_LEADER=route.leader.caddy
