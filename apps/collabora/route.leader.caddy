{$COLLABORA_SITE} {
  import common_proxy
  # The embedded admin console is not part of the document workflow. Its
  # credentials are container-local, so the public edge never offers it.
  @admin_console path /browser/dist/admin* /cool/adminws*
  respond @admin_console 403
  reverse_proxy {$COLLABORA_UPSTREAM} {
    transport http {
      tls_insecure_skip_verify
    }
    health_uri /hosting/discovery
    health_interval 10s
    health_timeout 5s
    health_fails 3
    health_passes 1
    flush_interval -1
    header_up Host {http.reverse_proxy.upstream.hostport}
  }
  handle_errors {
    @upstream_unavailable expression `{http.error.status_code} >= 500`
    respond @upstream_unavailable "collabora unavailable" 503
  }
}
