{$OUTLINE_SITE} {
  import common_proxy
  reverse_proxy {$OUTLINE_UPSTREAM} {
    transport http {
      tls_insecure_skip_verify
      response_header_timeout 24h
      read_timeout 24h
      write_timeout 24h
    }
    fail_duration 30s
    health_uri /_health
    health_interval 30s
    health_timeout 15s
    health_fails 3
    health_passes 1
    header_up Host {http.reverse_proxy.upstream.hostport}
    header_up X-Forwarded-Host {$OUTLINE_SITE_HOST}
    header_up X-Forwarded-Proto {scheme}
    header_up X-Forwarded-For {remote_host}
    import forward_verified_client_ip
  }
  handle_errors {
    @upstream_unavailable expression `{http.error.status_code} >= 500`
    respond @upstream_unavailable "outline unavailable" 503
  }
}
