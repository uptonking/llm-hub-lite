{$NODE_OUTLINE_ORIGIN_HOST} {
  # Private Leader-to-follower origin.
  tls internal
  import common_proxy
  reverse_proxy outline:3000 {
    flush_interval -1
    transport http {
      response_header_timeout 24h
      read_timeout 24h
      write_timeout 24h
    }
    header_up Host {$OUTLINE_SITE_HOST}
    header_up X-Forwarded-Host {$OUTLINE_SITE_HOST}
    header_up X-Forwarded-Proto https
    header_up X-Forwarded-For {remote_host}
    import forward_verified_client_ip
  }
}
