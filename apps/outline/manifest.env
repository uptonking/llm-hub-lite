MANIFEST_VERSION=5
APP_ID=outline
DISPLAY_NAME=Outline
PLACEMENT=consumer
UPSTREAM_MODE=singleton
POLICY_FILE=cluster/apps/outline.policy
ORIGIN_HOST_KEY=NODE_OUTLINE_ORIGIN_HOST
PUBLIC_ENDPOINTS=OUTLINE_SITE|outline
LEADER_UPSTREAM_KEY=OUTLINE_UPSTREAM
ROUTE_GROUPS=OUTLINE_SITE|NODE_OUTLINE_ORIGIN_HOST|OUTLINE_UPSTREAM
RUNTIME_ENV_FILE=outline.env
RUNTIME_ENV_PROVISION=stage
CONFIG_FILE=config.env
CLUSTER_SECRET_KEYS=
NODE_SECRET_KEYS=OUTLINE_SECRET_KEY,OUTLINE_UTILS_SECRET,OUTLINE_DB_PASSWORD,OUTLINE_OIDC_CLIENT_SECRET
WOODPECKER_SECRET_NAMES=OUTLINE_OIDC_CLIENT_SECRET:auther_outline_oidc_secret
GENERATED_SECRET_KEYS=OUTLINE_SECRET_KEY,OUTLINE_UTILS_SECRET,OUTLINE_DB_PASSWORD
GENERATED_SECRET_BYTES=OUTLINE_SECRET_KEY:32,OUTLINE_UTILS_SECRET:32,OUTLINE_DB_PASSWORD:16
SECRET_MIN_LENGTHS=OUTLINE_SECRET_KEY:64,OUTLINE_UTILS_SECRET:64,OUTLINE_DB_PASSWORD:32,OUTLINE_OIDC_CLIENT_SECRET:32
SECRET_REGEXES=OUTLINE_SECRET_KEY:^[A-Fa-f0-9]{64}$,OUTLINE_UTILS_SECRET:^[A-Fa-f0-9]{64}$,OUTLINE_DB_PASSWORD:^[A-Fa-f0-9]{32}$
ENV_KEYS=OUTLINE_MEMORY_LIMIT,OUTLINE_CPUS,OUTLINE_PIDS_LIMIT,OUTLINE_POSTGRES_MEMORY_LIMIT,OUTLINE_POSTGRES_CPUS,OUTLINE_POSTGRES_SHARED_BUFFERS,OUTLINE_REDIS_MEMORY_LIMIT,OUTLINE_REDIS_MAX_MEMORY,OUTLINE_MAX_UPLOAD_SIZE,OUTLINE_DEFAULT_LANGUAGE
MOVE_MODE=fresh
STATE_MODE=files
RECOVERY_REQUIRED_PATHS=postgres/pgdata/PG_VERSION
COMPOSE_FILE=compose.yml
COMPOSE_PROJECT=app-outline
SERVICE_NAME=outline
NETWORK_ALIAS=outline
IMAGE_KEYS=OUTLINE_IMAGE OUTLINE_POSTGRES_IMAGE OUTLINE_REDIS_IMAGE
DATA_ROOT_REL=outline
HEALTH_URL=/_health
HEALTH_PORT=3000
HEALTH_EXPECT=OK
SMOKE_URL_KEY=OUTLINE_SITE
SMOKE_LOCAL=healthcheck
HEALTH_MODE=healthcheck
HEALTH_SERVICE=
ROUTE_TEMPLATE_FOLLOWER=route.follower.caddy
ROUTE_TEMPLATE_LEADER=route.leader.caddy
