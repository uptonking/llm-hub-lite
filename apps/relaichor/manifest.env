ORIGIN_HOST_KEY=NODE_RELAICHOR_ORIGIN_HOST
PUBLIC_ENDPOINTS=RELAICHOR_SITE|relaichor
LEADER_UPSTREAM_KEY=RELAICHOR_UPSTREAM
ROUTE_GROUPS=RELAICHOR_SITE|NODE_RELAICHOR_ORIGIN_HOST|RELAICHOR_UPSTREAM
RUNTIME_ENV_FILE=
CONFIG_FILE=config.env
CLUSTER_SECRET_KEYS=
NODE_SECRET_KEYS=
OPTIONAL_SECRET_KEYS=
GENERATED_SECRET_KEYS=
WOODPECKER_SECRET_NAMES=
ENV_KEYS=RELAICHOR_MEMORY_LIMIT,RELAICHOR_CPUS,RELAICHOR_PIDS_LIMIT,RELAICHOR_PORT,RELAICHOR_ACCEPTORS,RELAICHOR_CONNECTIONS_PER_ACCEPTOR,RELAICHOR_HTTP_IDLE_TIMEOUT_MS,RELAICHOR_CAPACITY_MUTATION_TIMEOUT_MS,RELAICHOR_INGRESS_BUDGET_BYTES,RELAICHOR_INGRESS_WEIGHT,RELAICHOR_DELIVERY_TIMEOUT_MS,RELAICHOR_TRANSPORT_SEND_TIMEOUT_MS,RELAICHOR_CONTROL_QUEUE_BYTES,RELAICHOR_DATA_ATTACH_TIMEOUT_MS,RELAICHOR_TCP_RECEIVE_BUFFER_BYTES,RELAICHOR_MEMORY_WATERMARK_BYTES,RELAICHOR_MIN_CLUSTER_SIZE,RELAICHOR_OWNERSHIP_TARGET,RELAICHOR_REROUTE_HEADER
MOVE_MODE=fresh
STATE_MODE=ephemeral
COMPOSE_FILE=compose.yml
COMPOSE_PROJECT=app-relaichor
SERVICE_NAME=relaichor
NETWORK_ALIAS=relaichor
IMAGE_KEYS=RELAICHOR_IMAGE HEALTH_PROBE_IMAGE
DATA_ROOT_REL=
