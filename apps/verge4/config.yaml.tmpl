listen: :443,20000-30000
acme:
  domains:
    - verge4.aichorage.de
  email: __VERGE4_ACME_EMAIL__
  type: dns
  dns:
    name: cloudflare
    config:
      cloudflare_api_token: __VERGE4_CLOUDFLARE_API_TOKEN__
auth:
  type: password
  password: __VERGE4_AUTH_PASSWORD__
masquerade:
  type: proxy
  proxy:
    url: https://www.aichorage.de/
