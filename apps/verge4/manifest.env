MANIFEST_VERSION=5
APP_ID=verge4
DISPLAY_NAME=Verge4 (Hysteria)
PLACEMENT=consumer
UPSTREAM_MODE=singleton
INGRESS_MODE=direct
DIRECT_LISTENERS=udp:443:443
DIRECT_PORT_RANGES=udp:20000:30000:443
DIRECT_PROBE=socket
POLICY_FILE=cluster/apps/verge4.policy
PUBLIC_ENDPOINTS=VERGE4_SITE|verge4
RUNTIME_ENV_FILE=verge4.env
RUNTIME_ENV_PROVISION=stage
RUNTIME_CONFIG_TEMPLATE=config.yaml.tmpl
RUNTIME_CONFIG_FILE=runtime/verge4/config.yaml
CONFIG_FILE=config.env
CLUSTER_SECRET_KEYS=
NODE_SECRET_KEYS=VERGE4_AUTH_PASSWORD,VERGE4_CLOUDFLARE_API_TOKEN
WOODPECKER_SECRET_NAMES=VERGE4_CLOUDFLARE_API_TOKEN:verge_cloudflare_api_token
GENERATED_SECRET_KEYS=VERGE4_AUTH_PASSWORD
GENERATED_SECRET_BYTES=VERGE4_AUTH_PASSWORD:32
SECRET_MIN_LENGTHS=VERGE4_AUTH_PASSWORD:32,VERGE4_CLOUDFLARE_API_TOKEN:20
ENV_KEYS=VERGE4_MEMORY_LIMIT,VERGE4_CPUS,VERGE4_PIDS_LIMIT,VERGE4_LOG_LEVEL,VERGE4_GOMAXPROCS,VERGE4_GOMEMLIMIT,VERGE4_DOMAIN,VERGE4_ACME_EMAIL
MOVE_MODE=fresh
STATE_MODE=files
COMPOSE_FILE=compose.yml
COMPOSE_PROJECT=app-verge4
SERVICE_NAME=verge4
NETWORK_ALIAS=verge4
IMAGE_KEYS=VERGE4_IMAGE
DATA_ROOT_REL=verge4
HEALTH_URL=/
SMOKE_URL_KEY=VERGE4_SITE
SMOKE_LOCAL=healthcheck
HEALTH_MODE=process
HEALTH_SERVICE=
