MANIFEST_VERSION=3
APP_ID=newapi
PLACEMENT=follower
UPSTREAM_MODE=active-active
POLICY_FILE=cluster/apps/newapi.policy
ROUTE_GROUPS=NEW_API_SITE|NODE_NEW_API_ORIGIN_HOST|NEW_API_UPSTREAMS
COMPOSE_FILE=compose.yml
COMPOSE_PROJECT=app-newapi
SERVICE_NAME=newapi
NETWORK_ALIAS=newapi
IMAGE_KEYS=NEW_API_IMAGE
DATA_ROOT_REL=new-api
SQLITE_PATHS=
HEALTH_URL=/api/status
HEALTH_EXPECT='"success":true'
SMOKE_URL_KEY=NEW_API_SITE
SMOKE_LOCAL=healthcheck
ROUTE_TEMPLATE_FOLLOWER=route.follower.caddy
ROUTE_TEMPLATE_LEADER=route.leader.caddy
