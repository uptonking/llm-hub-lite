MANIFEST_VERSION=5
APP_ID=newapi
DISPLAY_NAME=Legacy New API
PLACEMENT=consumer
UPSTREAM_MODE=active-active
POLICY_FILE=cluster/apps/newapi.policy
CONFIG_FILE=config.env
PUBLIC_ENDPOINTS=NEW_API_SITE|newapi
CLUSTER_SECRET_KEYS=NEW_API_SQL_DSN,NEW_API_SESSION_SECRET,NEW_API_CRYPTO_SECRET
NODE_SECRET_KEYS=
NODE_DEFAULTS=NEW_API_NODE_TYPE|slave
GENERATED_SECRET_KEYS=NEW_API_SESSION_SECRET,NEW_API_CRYPTO_SECRET
SECRET_MIN_LENGTHS=NEW_API_SESSION_SECRET:32,NEW_API_CRYPTO_SECRET:32
ENV_KEYS=NEW_API_REDIS_URL,NEW_API_SQL_MAX_IDLE_CONNS,NEW_API_SQL_MAX_OPEN_CONNS,NEW_API_SQL_MAX_LIFETIME
ROUTE_GROUPS=NEW_API_SITE|NODE_NEW_API_ORIGIN_HOST|NEW_API_UPSTREAMS
COMPOSE_FILE=compose.yml
COMPOSE_PROJECT=app-newapi
SERVICE_NAME=newapi
NETWORK_ALIAS=newapi
IMAGE_KEYS=NEW_API_IMAGE
DATA_ROOT_REL=new-api
SQLITE_PATHS=
HEALTH_URL=/api/status
HEALTH_EXPECT='"success":true'
SMOKE_URL_KEY=NEW_API_SITE
SMOKE_LOCAL=healthcheck
HEALTH_MODE=healthcheck
ROUTE_TEMPLATE_FOLLOWER=route.follower.caddy
ROUTE_TEMPLATE_LEADER=route.leader.caddy
