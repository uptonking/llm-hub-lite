{$NEW_API_SITE} {
  import common_proxy
  reverse_proxy {$NEW_API_UPSTREAMS} {
    lb_policy random_choose 2
    lb_try_duration 5s
    lb_try_interval 250ms
    fail_duration 30s
    health_uri /api/status
    health_interval 10s
    health_timeout 3s
    # Route selection on the Follower is based on its origin hostname. Caddy
    # preserves the public hostname in X-Forwarded-Host by default, while this
    # sets the upstream Host/SNI to the origin for Follower routing.
    header_up Host {http.reverse_proxy.upstream.hostport}
  }
}
