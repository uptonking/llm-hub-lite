MANIFEST_VERSION=5
APP_ID=openclouds
DISPLAY_NAME=OpenClouds
PLACEMENT=consumer
UPSTREAM_MODE=singleton
POLICY_FILE=cluster/apps/openclouds.policy
ORIGIN_HOST_KEY=NODE_OPENCLOUDS_ORIGIN_HOST
PUBLIC_ENDPOINTS=OPENCLOUDS_SITE|openclouds
LEADER_UPSTREAM_KEY=OPENCLOUDS_UPSTREAM
ROUTE_GROUPS=OPENCLOUDS_SITE|NODE_OPENCLOUDS_ORIGIN_HOST|OPENCLOUDS_UPSTREAM
RUNTIME_ENV_FILE=openclouds.env
RUNTIME_ENV_PROVISION=stage
CONFIG_FILE=config.env
CLUSTER_SECRET_KEYS=
NODE_SECRET_KEYS=OPENCLOUDS_ADMIN_PASSWORD
GENERATED_SECRET_KEYS=OPENCLOUDS_ADMIN_PASSWORD
GENERATED_SECRET_BYTES=OPENCLOUDS_ADMIN_PASSWORD:16
SECRET_MIN_LENGTHS=OPENCLOUDS_ADMIN_PASSWORD:32
SECRET_REGEXES=OPENCLOUDS_ADMIN_PASSWORD:^[A-Fa-f0-9]{32}$
ENV_KEYS=OPENCLOUDS_MEMORY_LIMIT,OPENCLOUDS_CPUS,OPENCLOUDS_PIDS_LIMIT,OPENCLOUDS_DEFAULT_QUOTA_BYTES
MOVE_MODE=fresh
STATE_MODE=files
DATA_ROOT_REL=openclouds
RECOVERY_REQUIRED_PATHS=config/opencloud.yaml
COMPOSE_FILE=compose.yml
COMPOSE_PROJECT=app-openclouds
SERVICE_NAME=openclouds
NETWORK_ALIAS=openclouds
IMAGE_KEYS=OPENCLOUDS_IMAGE
HEALTH_URL=/status.php
HEALTH_PORT=9200
HEALTH_EXPECT="installed":true
SMOKE_URL_KEY=OPENCLOUDS_SITE
SMOKE_LOCAL=healthcheck
HEALTH_MODE=healthcheck
HEALTH_SERVICE=
ROUTE_TEMPLATE_FOLLOWER=route.follower.caddy
ROUTE_TEMPLATE_LEADER=route.leader.caddy
