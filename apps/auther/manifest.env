MANIFEST_VERSION=5
APP_ID=auther
DISPLAY_NAME=Auther (Authelia OIDC)
PLACEMENT=consumer
UPSTREAM_MODE=singleton
POLICY_FILE=cluster/apps/auther.policy
ORIGIN_HOST_KEY=NODE_AUTHER_ORIGIN_HOST
PUBLIC_ENDPOINTS=AUTHER_SITE|auther
LEADER_UPSTREAM_KEY=AUTHER_UPSTREAM
ROUTE_GROUPS=AUTHER_SITE|NODE_AUTHER_ORIGIN_HOST|AUTHER_UPSTREAM
RUNTIME_ENV_FILE=auther.env
RUNTIME_ENV_PROVISION=stage
CONFIG_FILE=config.env
CLUSTER_SECRET_KEYS=
NODE_SECRET_KEYS=AUTHER_SESSION_SECRET,AUTHER_STORAGE_ENCRYPTION_KEY,AUTHER_JWT_SECRET,AUTHER_OIDC_HMAC_SECRET,AUTHER_BOOTSTRAP_ADMIN_PASSWORD,AUTHER_OIDC_LADOCS_CLIENT_SECRET
WOODPECKER_SECRET_NAMES=AUTHER_OIDC_LADOCS_CLIENT_SECRET:auther_ladocs_oidc_secret
GENERATED_SECRET_KEYS=AUTHER_SESSION_SECRET,AUTHER_STORAGE_ENCRYPTION_KEY,AUTHER_JWT_SECRET,AUTHER_OIDC_HMAC_SECRET,AUTHER_BOOTSTRAP_ADMIN_PASSWORD
GENERATED_SECRET_BYTES=AUTHER_SESSION_SECRET:32,AUTHER_STORAGE_ENCRYPTION_KEY:32,AUTHER_JWT_SECRET:32,AUTHER_OIDC_HMAC_SECRET:32,AUTHER_BOOTSTRAP_ADMIN_PASSWORD:16
SECRET_MIN_LENGTHS=AUTHER_SESSION_SECRET:64,AUTHER_STORAGE_ENCRYPTION_KEY:64,AUTHER_JWT_SECRET:64,AUTHER_OIDC_HMAC_SECRET:64,AUTHER_BOOTSTRAP_ADMIN_PASSWORD:32,AUTHER_OIDC_LADOCS_CLIENT_SECRET:32
ENV_KEYS=AUTHER_MEMORY_LIMIT,AUTHER_CPUS,AUTHER_PIDS_LIMIT,AUTHER_LOG_LEVEL,AUTHER_THEME
MOVE_MODE=fresh
STATE_MODE=files
RECOVERY_REQUIRED_PATHS=db.sqlite3,users_database.yml,oidc-rsa-private.pem
COMPOSE_FILE=compose.yml
COMPOSE_PROJECT=app-auther
SERVICE_NAME=auther
NETWORK_ALIAS=auther
IMAGE_KEYS=AUTHER_IMAGE
DATA_ROOT_REL=auther
HEALTH_URL=/api/health
HEALTH_PORT=9091
HEALTH_EXPECT='"status":"OK"'
SMOKE_URL_KEY=AUTHER_SITE
SMOKE_LOCAL=healthcheck
HEALTH_MODE=healthcheck
HEALTH_SERVICE=
ROUTE_TEMPLATE_FOLLOWER=route.follower.caddy
ROUTE_TEMPLATE_LEADER=route.leader.caddy
