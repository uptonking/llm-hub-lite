MANIFEST_VERSION=5
APP_ID=verge-relay
DISPLAY_NAME=Verge Relay (gost)
PLACEMENT=consumer
UPSTREAM_MODE=singleton
INGRESS_MODE=direct
DIRECT_LISTENERS=udp:2053:2053
DIRECT_PORT_RANGES=udp:31000:36000:2053
DIRECT_PROBE=socket
DIRECT_FORWARD_TARGET=verge3.aichorage.de:443
POLICY_FILE=cluster/apps/verge-relay.policy
PUBLIC_ENDPOINTS=VERGE_RELAY_SITE|verge-relay
CONFIG_FILE=config.env
ENV_KEYS=VERGE_RELAY_TARGET,VERGE_RELAY_MEMORY_LIMIT,VERGE_RELAY_CPUS,VERGE_RELAY_PIDS_LIMIT
COMPOSE_FILE=compose.yml
COMPOSE_PROJECT=app-verge-relay
SERVICE_NAME=verge-relay
NETWORK_ALIAS=verge-relay
IMAGE_KEYS=VERGE_RELAY_IMAGE
HEALTH_URL=/
SMOKE_URL_KEY=VERGE_RELAY_SITE
SMOKE_LOCAL=healthcheck
HEALTH_MODE=process
HEALTH_SERVICE=
STATE_MODE=ephemeral
MOVE_MODE=fresh
