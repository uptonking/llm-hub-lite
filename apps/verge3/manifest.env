MANIFEST_VERSION=5
APP_ID=verge3
DISPLAY_NAME=Verge3 (Hysteria)
PLACEMENT=consumer
UPSTREAM_MODE=singleton
INGRESS_MODE=direct
DIRECT_LISTENERS=udp:443:443
DIRECT_PORT_RANGES=udp:20000:30000:443
DIRECT_PROBE=socket
POLICY_FILE=cluster/apps/verge3.policy
PUBLIC_ENDPOINTS=VERGE3_SITE|verge3
RUNTIME_ENV_FILE=verge3.env
RUNTIME_ENV_PROVISION=stage
RUNTIME_CONFIG_TEMPLATE=config.yaml.tmpl
RUNTIME_CONFIG_FILE=runtime/verge3/config.yaml
CONFIG_FILE=config.env
CLUSTER_SECRET_KEYS=
NODE_SECRET_KEYS=VERGE3_AUTH_PASSWORD,VERGE3_CLOUDFLARE_API_TOKEN
WOODPECKER_SECRET_NAMES=VERGE3_CLOUDFLARE_API_TOKEN:verge_cloudflare_api_token
GENERATED_SECRET_KEYS=VERGE3_AUTH_PASSWORD
GENERATED_SECRET_BYTES=VERGE3_AUTH_PASSWORD:32
SECRET_MIN_LENGTHS=VERGE3_AUTH_PASSWORD:32,VERGE3_CLOUDFLARE_API_TOKEN:20
ENV_KEYS=VERGE3_MEMORY_LIMIT,VERGE3_CPUS,VERGE3_PIDS_LIMIT,VERGE3_LOG_LEVEL,VERGE3_GOMAXPROCS,VERGE3_GOMEMLIMIT,VERGE3_DOMAIN,VERGE3_ACME_EMAIL
MOVE_MODE=fresh
STATE_MODE=files
COMPOSE_FILE=compose.yml
COMPOSE_PROJECT=app-verge3
SERVICE_NAME=verge3
NETWORK_ALIAS=verge3
IMAGE_KEYS=VERGE3_IMAGE
DATA_ROOT_REL=verge3
HEALTH_URL=/
SMOKE_URL_KEY=VERGE3_SITE
SMOKE_LOCAL=healthcheck
HEALTH_MODE=process
HEALTH_SERVICE=
