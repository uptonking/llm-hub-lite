MANIFEST_VERSION=5
APP_ID=mailer
DISPLAY_NAME=Mailer (Stalwart)
PLACEMENT=consumer
UPSTREAM_MODE=singleton
INGRESS_MODE=direct-and-proxy
DIRECT_LISTENERS=tcp:25:25,tcp:465:465,tcp:587:587,tcp:993:993,tcp:4190:4190
DIRECT_PROBE=healthcheck
POLICY_FILE=cluster/apps/mailer.policy
ORIGIN_HOST_KEY=NODE_MAILER_ORIGIN_HOST
PUBLIC_ENDPOINTS=MAILER_SITE|mail
LEADER_UPSTREAM_KEY=MAILER_UPSTREAM
ROUTE_GROUPS=MAILER_SITE|NODE_MAILER_ORIGIN_HOST|MAILER_UPSTREAM
RUNTIME_ENV_FILE=mailer.env
RUNTIME_ENV_PROVISION=stage
CONFIG_FILE=config.env
CLUSTER_SECRET_KEYS=
NODE_SECRET_KEYS=MAILER_ADMIN_PASSWORD,MAILER_CLOUDFLARE_API_TOKEN
WOODPECKER_SECRET_NAMES=MAILER_CLOUDFLARE_API_TOKEN:verge_cloudflare_api_token
GENERATED_SECRET_KEYS=MAILER_ADMIN_PASSWORD
GENERATED_SECRET_BYTES=MAILER_ADMIN_PASSWORD:16
SECRET_MIN_LENGTHS=MAILER_ADMIN_PASSWORD:32,MAILER_CLOUDFLARE_API_TOKEN:20
SECRET_REGEXES=MAILER_ADMIN_PASSWORD:^[A-Fa-f0-9]{32}$
ENV_KEYS=MAILER_MEMORY_LIMIT,MAILER_CPUS,MAILER_PIDS_LIMIT,MAILER_SITE,MAILER_DOMAIN,MAILER_HOSTNAME,MAILER_MAX_CONNECTIONS
MOVE_MODE=fresh
STATE_MODE=files
DATA_ROOT_REL=mailer
COMPOSE_FILE=compose.yml
COMPOSE_PROJECT=app-mailer
SERVICE_NAME=mailer
NETWORK_ALIAS=mailer
IMAGE_KEYS=MAILER_IMAGE
HEALTH_URL=/healthz/live
HEALTH_PORT=8080
HEALTH_EXPECT=
SMOKE_URL_KEY=MAILER_SITE
SMOKE_LOCAL=healthcheck
HEALTH_MODE=healthcheck
HEALTH_SERVICE=
ROUTE_TEMPLATE_FOLLOWER=route.follower.caddy
ROUTE_TEMPLATE_LEADER=route.leader.caddy
