MANIFEST_VERSION=3
APP_ID=cliproxyapi
PLACEMENT=follower
UPSTREAM_MODE=active-passive
POLICY_FILE=cluster/apps/cliproxyapi.policy
PRIMARY_NODE_KEY=CLIPROXY_PRIMARY_NODE_ID
ROUTE_GROUPS=CLIPROXY_SITE|NODE_CLIPROXY_ORIGIN_HOST|CLIPROXY_UPSTREAMS
COMPOSE_FILE=compose.yml
COMPOSE_PROJECT=app-cliproxyapi
SERVICE_NAME=cliproxyapi
NETWORK_ALIAS=cliproxyapi
IMAGE_KEYS=CLIPROXY_IMAGE
DATA_ROOT_REL=cliproxy
SQLITE_PATHS=
HEALTH_URL=/management.html
HEALTH_EXPECT=
SMOKE_URL_KEY=CLIPROXY_SITE
SMOKE_LOCAL=healthcheck
ROUTE_TEMPLATE_FOLLOWER=route.follower.caddy
ROUTE_TEMPLATE_LEADER=route.leader.caddy
