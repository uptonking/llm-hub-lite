# Copy to .env.production, set real values, and chmod 600 .env.production.
DOMAIN_NAME=example.com
SSL_EMAIL=admin@example.com
SHARED_NETWORK_NAME=shared_network
DATA_ROOT=./data/prod
TZ=Asia/Shanghai
NEW_API_SESSION_SECRET=replace-with-a-random-secret
CLIPROXY_API_KEY=replace-with-a-random-api-key
CLIPROXY_MANAGEMENT_KEY=replace-with-a-random-management-key
NEW_API_SITE=https://newapi.example.com
CLIPROXY_SITE=https://cpa.example.com
SESSION_COOKIE_TRUSTED_URL=https://newapi.example.com
CADDY_IMAGE=caddy:latest
NEW_API_IMAGE=calciumion/new-api:latest
CLIPROXY_IMAGE=eceasy/cli-proxy-api:latest
