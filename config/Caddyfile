{
	email {$SSL_EMAIL:dev@example.invalid}
	log {
		level INFO
		format json
	}
	# Cloudflare's current proxy ranges (IPv4/IPv6), plus the host-local Leader
	# address used for the second proxy hop on Followers:
	# https://www.cloudflare.com/ips/
	servers {
		trusted_proxies static {$LEADER_PUBLIC_IP} 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP
	}
}

(common_proxy) {
	encode zstd gzip
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
}

# Rewrite every commonly consumed client-IP header from Caddy's verified
# client address. Import this inside reverse_proxy blocks that cross a trust
# boundary; downstream services never receive caller-supplied values.
(forward_verified_client_ip) {
	header_up CF-Connecting-IP {client_ip}
	header_up X-Forwarded-For {client_ip}
	header_up X-Real-IP {client_ip}
}

import /etc/caddy/foundation-routes.d/*.caddy
import /etc/caddy/routes.d/*.caddy
