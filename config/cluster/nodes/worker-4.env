NODE_ID=worker-4
NODE_STATE=active
# Wobase is stateful, but this small node intentionally has no scheduled
# Restic work. Physical VPS migration still includes its local application data.
BACKUP_ENABLED=false
NODE_NEW_API_ORIGIN_HOST=worker4-newapi-origin.aichorage.de
NODE_CPAPI_ORIGIN_HOST=worker4-cpapi-origin.aichorage.de
NODE_LIBRECHAT_ORIGIN_HOST=worker4-chat-origin.aichorage.de
NODE_LIBRECHAT_ADMIN_ORIGIN_HOST=worker4-chat-admin-origin.aichorage.de
NODE_AICHOROUTER_ORIGIN_HOST=worker4-aichorouter-origin.aichorage.de
NODE_CURSORAPI_ORIGIN_HOST=worker4-cursorapi-origin.aichorage.de
NODE_PIGEON_ORIGIN_HOST=worker4-pigeon-origin.aichorage.de
NODE_FLOWY_ORIGIN_HOST=worker4-flowy-origin.aichorage.de
NODE_WOBASE_ORIGIN_HOST=worker4-wobase-origin.aichorage.de
WOODPECKER_AGENT_LABELS=node=worker-4,deployment=true,target=production,repo=uptonking/llm-hub-lite
BESZEL_SYSTEM_NAME=worker-4
NEW_API_NODE_TYPE=slave
