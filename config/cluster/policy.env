# Versioned cluster policy. This file is committed and contains no secrets.
# Cluster reconciliation also restores complete image manifests and repairs
# missing application routes after control/service release drift.
CLUSTER_CONFIG_VERSION=3
LEADER_NODE_ID=leader
NODE_IDS=leader,worker-1,worker-2,worker-3,worker-4,worker-5
REPO_SLUG=uptonking/llm-hub-lite
# Canonical digest-pinned image used by every Woodpecker deployment step and
# every node's platform-submit wrapper. Keep this public so agents can pull it.
DEPLOY_RUNNER_IMAGE=ghcr.io/uptonking/llm-hub-lite-deploy-runner:v0.4.0@sha256:1038afc7446cdba70318586753adba3d4a2c78e1f5e878d8adfa68e06ac2af25
# Woodpecker deployment log verbosity: off, warn, or debug.
DEPLOY_DEBUG_LEVEL=off
# Reviewed public listeners for direct/orphan applications. Applications may
# only reserve protocol/host-port pairs listed here. Port-hop ranges use the
# protocol/first-last form (e.g. udp/20000-30000) and DNAT onto a declared
# listener port, so they never publish an unpinned service port.
DIRECT_PORT_ALLOWLIST=udp/443,udp/20000-30000,udp/2053,udp/31000-36000,tcp/25,tcp/465,tcp/587,tcp/993,tcp/4190
# Follower Caddy keeps HTTP/3 on loopback so direct UDP listeners may reserve
# public ports without node-specific exceptions.
CADDY_HTTPS_UDP_FALLBACK_PORT=8443
# Reviewed Cloudflare proxy ranges. The Leader's 443/tcp and 443/udp rules admit
# only these networks, together with the root-only direct-source file
# /etc/llm-hub-lite/edge-ingress-sources.env, the Leader's own public address and
# 172.16.0.0/12 for container-originated traffic. Keep this table identical to
# trusted_proxies in config/Caddyfile; ops/check-ip-privacy.sh fails when the two
# drift. Source of truth: https://www.cloudflare.com/ips/.
EDGE_INGRESS_CLOUDFLARE_RANGES=173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22,2400:cb00::/32,2606:4700::/32,2803:f800::/32,2405:b500::/32,2405:8100::/32,2a06:98c0::/29,2c0f:f248::/32
