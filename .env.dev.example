OBSERVER_SITE=http://observer.localhost
OBSERVER_API_URL=http://observer.localhost
OBSERVER_INGEST_SITE=http://observer-ingest.localhost
# Local collectors share the private Docker network with the controller. The
# public-style observer-ingest.localhost route remains available for manual
# browser/API testing, but containers cannot resolve it to the host Caddy.
OBSERVER_INGEST_URL=http://observer-controller:5080
OBSERVER_ROOT_USER_EMAIL=root@example.com
OBSERVER_ROOT_USER_PASSWORD=local-development-observer-password
OBSERVER_INGEST_USER=local-development-collector
OBSERVER_INGEST_TOKEN=o2oi_00000000000000000000000000000000
OBSERVER_COOKIE_SECURE_ONLY=false
OBSERVER_MEMORY_LIMIT=512m
OBSERVER_CPUS=0.50
OBSERVER_PIDS_LIMIT=256
OBSERVER_QUERY_THREAD_NUM=1
OBSERVER_HTTP_WORKER_NUM=1
OBSERVER_HTTP_WORKER_MAX_BLOCKING=16
OBSERVER_GRPC_RUNTIME_WORKER_NUM=1
OBSERVER_GRPC_RUNTIME_BLOCKING_WORKER_NUM=16
OBSERVER_JOB_RUNTIME_WORKER_NUM=1
OBSERVER_JOB_RUNTIME_BLOCKING_WORKER_NUM=16
OBSERVER_WAL_RUNTIME_WORKER_NUM=1
OBSERVER_WAL_WRITE_QUEUE_SIZE=1000
OBSERVER_DATA_RETENTION_DAYS=30
OBSERVER_COMPACT_INTERVAL=30
OBSERVER_COMPACT_DATA_RETENTION_INTERVAL=3600
OBSERVER_COMPACT_TANTIVY_BUILDER_THREAD_NUM=1
OBSERVER_ENABLE_INVERTED_INDEX=false
OBSERVER_DISK_CACHE_MAX_SIZE=128
OBSERVER_LOG_ORGANIZATION=default
OBSERVER_LOG_STREAM=docker
OBSERVER_LOG_BUFFER_MAX_BYTES=536870912
