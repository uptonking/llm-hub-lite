# Copy to .env.dev for local development.
DOMAIN_NAME=localhost
SSL_EMAIL=dev@example.invalid
DEV_HTTP_PORT=4080
NEW_API_SITE=http://newapi.localhost
CLIPROXY_SITE=http://cpa.localhost
WOODPECKER_SITE=http://ci.localhost
BESZEL_SITE=http://status.localhost
AICHOROUTER_SITE=http://aichorouter.localhost
AICHOROUTER_GOMAXPROCS=1
AICHOROUTER_GOMEMLIMIT=300MiB
WOODPECKER_GRPC_SITE=http://ci-grpc.localhost
NEW_API_UPSTREAMS=http://127.0.0.1:3000
CLIPROXY_UPSTREAMS=http://127.0.0.1:8317
DATA_ROOT=./data/dev
SHARED_NETWORK_NAME=shared_network
PLATFORM_EDGE_NETWORK=platform_edge
TZ=Asia/Shanghai
NODE_ID=leader
CLUSTER_POLICY_FILE=./config/cluster/policy.env
NODE_CONFIG_FILE=./config/cluster/nodes/leader.env
NEW_API_SESSION_SECRET=local-development-session-secret
NEW_API_CRYPTO_SECRET=local-development-crypto-secret
NEW_API_SQL_DSN=file:/data/new-api-dev.db
NEW_API_REDIS_URL=
LIBRECHAT_MONGO_URI=mongodb://127.0.0.1:27017/LibreChat
LIBRECHAT_REDIS_URI=redis://127.0.0.1:6379
LIBRECHAT_JWT_SECRET=local-development-jwt-secret
LIBRECHAT_JWT_REFRESH_SECRET=local-development-jwt-refresh-secret
LIBRECHAT_ADMIN_PANEL_SESSION_SECRET=local-development-admin-session-secret
LIBRECHAT_ALLOW_REGISTRATION=true
LIBRECHAT_USE_REDIS=false
LIBRECHAT_USE_REDIS_STREAMS=false
LIBRECHAT_SEARCH=false
LIBRECHAT_DOMAIN_CLIENT=http://chat.localhost
LIBRECHAT_DOMAIN_SERVER=http://chat.localhost
LIBRECHAT_ADMIN_PANEL_URL=http://chat-admin.localhost
LIBRECHAT_SITE=http://chat.localhost
LIBRECHAT_ADMIN_SITE=http://chat-admin.localhost
LIBRECHAT_UPSTREAMS=http://127.0.0.1:3080
LIBRECHAT_ADMIN_UPSTREAMS=http://127.0.0.1:3000
LIBRECHAT_MONGO_BACKUP_ENABLED=false
LIBRECHAT_FILE_STRATEGY=local
LIBRECHAT_AWS_ENDPOINT_URL=https://r2.localhost
LIBRECHAT_AWS_ACCESS_KEY_ID=local-r2-access-key
LIBRECHAT_AWS_SECRET_ACCESS_KEY=local-r2-secret-key
LIBRECHAT_AWS_REGION=auto
LIBRECHAT_AWS_BUCKET_NAME=local-librechat
LIBRECHAT_AWS_FORCE_PATH_STYLE=true
CLIPROXY_API_KEY=local-development-api-key
CLIPROXY_MANAGEMENT_KEY=local-development-management-key
CADDY_IMAGE=caddy:2.10.0
LIBRECHAT_CLIENT_IMAGE=nginx:1.27.0-alpine
NEW_API_IMAGE=calciumion/new-api:v1.0.0-rc.25
CLIPROXY_IMAGE=eceasy/cli-proxy-api:v7.2.137
WOODPECKER_SERVER_IMAGE=woodpeckerci/woodpecker-server:v3.17.0
WOODPECKER_AGENT_IMAGE=woodpeckerci/woodpecker-agent:v3.17.0
BESZEL_HUB_IMAGE=henrygd/beszel:0.18.7
BESZEL_AGENT_IMAGE=henrygd/beszel-agent:0.18.7
BESZEL_SOCKET_PROXY_IMAGE=lscr.io/linuxserver/socket-proxy:latest
