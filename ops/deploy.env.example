# Copy this file to /etc/llm-hub-lite/deploy.env on the VPS.
APP_ROOT=/opt/apps/llm-hub-lite
REPO_URL=https://github.com/uptonking/llm-hub-lite.git
MAIN_BRANCH=main
ENV_FILE=/opt/apps/llm-hub-lite/shared/.env.production
RETAIN_RELEASES=5
BACKUP_RETENTION=10
DEPLOY_LOG=/opt/apps/llm-hub-lite/shared/logs/deploy.log
