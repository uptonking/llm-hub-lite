# Copy to /opt/platform/beszel/.env and chmod 600.
BESZEL_HUB_IMAGE=henrygd/beszel:0.18.7@sha256:a849ad80814b6a1a3be665304dcace5d4854b3bed7bde4dd1227e8ce1b82d477
BESZEL_AGENT_IMAGE=henrygd/beszel-agent:0.18.7@sha256:8874e2c53f9de5e063a6a80d6b617e20fa593ac5dc4eb4c6ce1f912f510f38f8
BESZEL_APP_URL=https://status.example.com
BESZEL_DATA_ROOT=/opt/platform/beszel/hub
BESZEL_AGENT_DATA_ROOT=/opt/platform/beszel/agent
BESZEL_KEY_FILE=/opt/platform/beszel/secrets/key
BESZEL_TOKEN_FILE=/opt/platform/beszel/secrets/token
BESZEL_SYSTEM_NAME=yaoodtnd.com
SHARED_NETWORK_NAME=shared_network
# Set to superusers or true after SMTP is configured.
BESZEL_MFA_OTP=false
BESZEL_DISABLE_PASSWORD_AUTH=false
BESZEL_USER_CREATION=false
