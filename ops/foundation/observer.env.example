OBSERVER_DATA_ROOT=/opt/platform/observer
OBSERVER_SITE=https://observer.example.com
OBSERVER_API_URL=http://observer-controller:5080
OBSERVER_COOKIE_SECURE_ONLY=true
# DNS-only record resolving directly to the Leader. Collectors use this host.
OBSERVER_INGEST_SITE=https://observer-ingest.example.com
OBSERVER_INGEST_URL=https://observer-ingest.example.com
OBSERVER_ROOT_USER_EMAIL=admin@example.com
OBSERVER_ROOT_USER_PASSWORD=replace-with-a-long-random-password
OBSERVER_INGEST_USER=llm-hub-lite-collector
OBSERVER_INGEST_TOKEN=replace-with-openobserve-ingestion-token
OBSERVER_LOG_ORGANIZATION=default
OBSERVER_LOG_STREAM=docker
OBSERVER_LOG_BUFFER_MAX_BYTES=536870912
# Diagnostics warn at these thresholds; they never delete Observer data.
OBSERVER_DURABLE_WARN_BYTES=8589934592
OBSERVER_LOG_BUFFER_WARN_PERCENT=80
OBSERVER_MEMORY_LIMIT=512m
OBSERVER_CPUS=0.50
OBSERVER_PIDS_LIMIT=256
OBSERVER_DATA_RETENTION_DAYS=30
OBSERVER_QUERY_THREAD_NUM=1
OBSERVER_HTTP_WORKER_NUM=1
OBSERVER_HTTP_WORKER_MAX_BLOCKING=16
OBSERVER_GRPC_RUNTIME_WORKER_NUM=1
OBSERVER_GRPC_RUNTIME_BLOCKING_WORKER_NUM=16
OBSERVER_JOB_RUNTIME_WORKER_NUM=1
OBSERVER_JOB_RUNTIME_BLOCKING_WORKER_NUM=16
OBSERVER_WAL_RUNTIME_WORKER_NUM=1
OBSERVER_WAL_WRITE_QUEUE_SIZE=1000
OBSERVER_COMPACT_INTERVAL=30
OBSERVER_COMPACT_DATA_RETENTION_INTERVAL=3600
OBSERVER_COMPACT_TANTIVY_BUILDER_THREAD_NUM=1
OBSERVER_ENABLE_INVERTED_INDEX=false
OBSERVER_DISK_CACHE_MAX_SIZE=128
OBSERVER_LOG_PROXY_MEMORY_LIMIT=32m
OBSERVER_LOG_PROXY_CPUS=0.10
OBSERVER_LOG_PROXY_PIDS_LIMIT=64
OBSERVER_LOG_SHIPPER_MEMORY_LIMIT=96m
OBSERVER_LOG_SHIPPER_CPUS=0.10
OBSERVER_LOG_SHIPPER_PIDS_LIMIT=128
OBSERVER_LOG_SHIPPER_THREADS=1
