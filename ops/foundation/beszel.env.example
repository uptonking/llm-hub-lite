BESZEL_APP_URL=https://status.example.com
BESZEL_DATA_ROOT=/opt/platform/beszel/hub
BESZEL_AGENT_DATA_ROOT=/opt/platform/beszel/agent
BESZEL_KEY_FILE=/opt/platform/beszel/secrets/key
BESZEL_TOKEN_FILE=/opt/platform/beszel/secrets/token
BESZEL_SYSTEM_NAME=vps
BESZEL_CONTAINER_DETAILS=false
BESZEL_SOCKET_PROXY_PORT=2375
BESZEL_SERVICE_PATTERNS=platform-*,docker.service,containerd.service,ssh.service
BESZEL_SYSTEMD_PRIVATE_SOCKET=/run/systemd/private
BESZEL_HEARTBEAT_URL=
BESZEL_HEARTBEAT_METHOD=POST
BESZEL_HEARTBEAT_INTERVAL=60
BESZEL_MFA_OTP=false
BESZEL_DISABLE_PASSWORD_AUTH=false
BESZEL_USER_CREATION=false
# Required by the Docker agent when AppArmor blocks systemd/D-Bus access.
BESZEL_AGENT_APPARMOR=unconfined
