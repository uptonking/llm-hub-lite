CADDY_DATA_ROOT=/opt/platform/caddy
CADDY_CONFIG_ROOT=/opt/apps/llm-hub-lite/shared/runtime/config
CADDY_HTTP_BIND=0.0.0.0
CADDY_HTTPS_BIND=0.0.0.0
CADDY_HTTPS_UDP_BIND=0.0.0.0
CADDY_HTTPS_UDP_HOST_PORT=443
# A cgroup limit is a cap, not a reservation, so headroom costs nothing while
# traffic is light. Size it well above Caddy's working set: a limit below it puts
# the kernel into synchronous reclaim inside Caddy's allocating threads, which
# stalls requests and TLS handshakes. With access logging on, Caddy peaked at
# 100MiB on the Leader, which also carries the largest route table, so 300m keeps
# roughly 3x headroom while still bounding a runaway process.
CADDY_MEMORY_LIMIT=300m
