CADDY_DATA_ROOT=/opt/platform/caddy
CADDY_CONFIG_ROOT=/opt/apps/llm-hub-lite/shared/runtime/config
CADDY_HTTP_BIND=0.0.0.0
CADDY_HTTPS_BIND=0.0.0.0
CADDY_HTTPS_UDP_BIND=0.0.0.0
CADDY_HTTPS_UDP_HOST_PORT=443
# Caddy's working set grew past the old 64m default once access logging was
# enabled, so the cgroup limit kept it in direct reclaim: the kernel stalled its
# allocating threads on every request. 192m leaves the Leader, which carries the
# largest route table, at roughly a third of the limit.
CADDY_MEMORY_LIMIT=192m
