WOODPECKER_DATA_ROOT=/opt/platform/woodpecker/data
WOODPECKER_AGENT_CONFIG_ROOT=/opt/platform/woodpecker/agent
WOODPECKER_HOST=https://ci.example.com
WOODPECKER_ADMIN=github-user
WOODPECKER_GITHUB_CLIENT=replace-with-oauth-client-id
WOODPECKER_GITHUB_SECRET=replace-with-oauth-client-secret
WOODPECKER_AGENT_SECRET=replace-with-random-agent-secret
WOODPECKER_GRPC_SECRET=replace-with-random-grpc-secret
WOODPECKER_REPO_OWNERS=uptonking
WOODPECKER_AGENT_LABELS=target=production,repo=uptonking/llm-hub-lite
WOODPECKER_MAX_WORKFLOWS=1
WOODPECKER_DATABASE_MAX_CONNECTIONS=1
WOODPECKER_DATABASE_IDLE_CONNECTIONS=1
WOODPECKER_FORCE_IGNORE_SERVICE_FAILURE=false
