[Unit]
Description=Retry llm-hub-lite Docker platform recovery
After=platform-network.service platform-firewall.service network-online.target
Requires=platform-network.service platform-firewall.service docker.service
Wants=network-online.target
RequiresMountsFor=/opt/apps/llm-hub-lite /opt/platform /etc/llm-hub-lite
StartLimitIntervalSec=15min
StartLimitBurst=5

[Service]
Type=exec
RuntimeMaxSec=420
Restart=on-failure
RestartSec=60s
# Recovery is maintenance work. Keep it below foreground application work on
# shared or oversubscribed VPS hosts.
Nice=10
CPUWeight=20
ExecStart=/usr/local/bin/platformctl recover --quiet
